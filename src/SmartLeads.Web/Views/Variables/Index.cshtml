@{
    ViewData["Title"] = "Variables";
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Variables</h5>
        <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#variableOffcanvas" onclick="openCreateModal()">
            <i class="bx bx-plus me-1"></i> Add Variable
        </button>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-center mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by type or value..." />
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-outline-primary" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-cog"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end gear-dropdown-variables" aria-labelledby="dropdownMenuButton1">
                            <div class="row p-4 main-dropdown-size overflow-hidden">
                                <div class="col">
                                    <span class="fw-bold ms-3">Columns</span>
                                    <hr class="m-0 w-75 ms-3 w-sm-50" />
                                    <ul class="list-unstyled" id="VariablesColumnList">
                                    </ul>
                                </div>
                            </div>
                            <div class="d-flex">
                                <div class="p-4">
                                    <button id="saveVariablesFilter" class="btn btn-outline-primary">Save Filter</button>
                                </div>
                                <div class="p-4">
                                    <button id="deleteVariablesFilter" class="btn btn-outline-danger" onclick="DeleteFilter_Variables('Variables')">Remove Filter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-export me-1"></i> Export
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button type="button" class="dropdown-item" id="exportCsvBtn">CSV</button></li>
                            <li><button type="button" class="dropdown-item" id="exportExcelBtn">Excel</button></li>
                            <li><button type="button" class="dropdown-item" id="exportPdfBtn">PDF</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div id="variableTable"></div>
    </div>
</div>

<!-- Variable Offcanvas -->
<div class="offcanvas offcanvas-end w-100" tabindex="-1" id="variableOffcanvas" aria-labelledby="variableOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="variableOffcanvasLabel">Add Variable</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="variableForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="variableId" name="Id" />
            <input type="hidden" id="formAction" value="create" />

            <h6 class="mb-3">Variable Information</h6>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="variableType" class="form-label">Type <span class="text-danger">*</span></label>
                    <select class="form-select" id="variableType" name="Type" required>
                        <option value="">Select Type</option>
                    </select>
                    <span class="text-danger" id="typeError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="variableValue" class="form-label">Value <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="variableValue" name="Value" placeholder="e.g., Male, Female, Muslim" required />
                    <span class="text-danger" id="valueError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="variableDescription" class="form-label">Description</label>
                    <textarea class="form-control" id="variableDescription" name="Description" rows="3" placeholder="Optional description"></textarea>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="variableSortOrder" class="form-label">Sort Order</label>
                    <input type="number" class="form-control" id="variableSortOrder" name="SortOrder" value="0" />
                </div>
            </div>

            <div class="row" id="isActiveRow" style="display: none;">
                <div class="col-12 mb-3">
                    <label for="variableIsActive" class="form-label">Status</label>
                    <select class="form-select" id="variableIsActive" name="IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary" id="submitBtn">Create Variable</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let variableOffcanvas = null;
        let variableTable = null;
        let searchTimeout = null;
        let currentSearch = '';

        var TableFields = [
            {
                title: "#",
                field: "rownum",
                formatter: "rownum",
                hozAlign: "center",
                headerSort: false,
                width: 50,
                visible: true
            },
            {
                title: "Type",
                field: "type",
                hozAlign: "left",
                visible: true
            },
            {
                title: "Value",
                field: "value",
                hozAlign: "left",
                visible: true
            },
            {
                title: "Description",
                field: "description",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Sort Order",
                field: "sortOrder",
                hozAlign: "center",
                visible: false
            },
            {
                title: "Status",
                field: "isActive",
                hozAlign: "center",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-secondary">Inactive</span>';
                }
            },
            {
                title: "Actions",
                field: "id",
                hozAlign: "center",
                headerSort: false,
                download: false,
                print: false,
                frozen: true,
                visible: true,
                formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const id = row.id || '';
                    const type = (row.type || '').toString().replace(/'/g, "\\'");
                    const value = (row.value || '').toString().replace(/'/g, "\\'");
                    const description = (row.description || '').toString().replace(/'/g, "\\'");
                    const sortOrder = row.sortOrder || 0;
                    const isActive = row.isActive || false;

                    return `
                        <button class="btn btn-sm btn-primary me-2"
                            onclick="openEditModal(
                                '${id}',
                                '${type}',
                                '${value}',
                                '${description}',
                                ${sortOrder},
                                ${isActive}
                            )">
                            <i class="bx bx-edit"></i> Edit
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteVariable('${id}', '${value}')">
                            <i class="bx bx-trash"></i> Delete
                        </button>
                    `;
                }
            }
        ];

        document.addEventListener('DOMContentLoaded', function() {
            variableOffcanvas = new bootstrap.Offcanvas(document.getElementById('variableOffcanvas'));
            VariablesGear();
        });

        function VariablesGear() {
            $.ajax({
                url: '@Url.Action("GetFilteredColumn", "ColumnFilter")',
                type: 'GET',
                data: { type: 'Variables' },
                success: function (response) {
                    console.log("GetFilteredColumn response:", response);

                    if ((response.Success == 1 || response.success == 1) && response.data && response.data.keyValue) {
                        try {
                            const savedData = JSON.parse(response.data.keyValue);
                            console.log("Parsed saved data:", savedData);

                            if (savedData.colDefs && Array.isArray(savedData.colDefs)) {
                                const newTableFields = [];

                                savedData.colDefs.forEach(savedCol => {
                                    const tableCol = TableFields.find(col => col.field === savedCol.field);
                                    if (tableCol) {
                                        tableCol.visible = savedCol.visible !== undefined ? savedCol.visible : true;
                                        newTableFields.push(tableCol);
                                    }
                                });

                                TableFields.forEach(col => {
                                    if (!newTableFields.find(c => c.field === col.field)) {
                                        newTableFields.push(col);
                                    }
                                });

                                TableFields.length = 0;
                                TableFields.push(...newTableFields);

                                console.log("Updated TableFields:", TableFields);
                            }
                        } catch (e) {
                            console.error("Error parsing saved columns:", e);
                        }
                    }
                    populateCheckbox();
                    initializeVariableTable();
                    setupSearchFilter();
                    setupExportButtons();
                    setupColumnFilterSave();
                },
                error: function (error) {
                    console.error("Error fetching column settings:", error);
                    populateCheckbox();
                    initializeVariableTable();
                    setupSearchFilter();
                    setupExportButtons();
                    setupColumnFilterSave();
                }
            });
        }

        function populateCheckbox() {
            let items = TableFields
                .filter(x => x.field !== 'id')
                .map(x => {
                    return `
                        <li class="d-flex justify-content-between align-items-center px-3 py-1 draggable-item" data-field="${x.field}">
                            <span class="d-flex align-items-center">
                                <i class="bx bx-menu me-2 handle" style="cursor: move;"></i> ${x.title}
                            </span>
                            <div class="form-check form-switch">
                                <input class="form-check-input toggle-column variables-column" type="checkbox" role="switch"
                                       id="${x.field}" value="${x.field}" ${x.visible ? 'checked' : ''}
                                       onclick="showHideColumn('${x.field}')">
                            </div>
                        </li>`;
                });

            const columnList = document.getElementById('VariablesColumnList');
            columnList.innerHTML = items.join('');
            enableDragAndDrop();
        }

        function enableDragAndDrop() {
            new Sortable(document.getElementById('VariablesColumnList'), {
                animation: 200,
                handle: '.handle',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'sortable-drag',
                forceFallback: true,
                fallbackTolerance: 5,
                scroll: true,
                scrollSensitivity: 30,
                scrollSpeed: 10,
                onEnd: function (evt) {
                    updateColumnOrder();
                }
            });
        }

        function updateColumnOrder() {
            let newOrder = [];
            document.querySelectorAll('#VariablesColumnList .draggable-item').forEach(item => {
                const field = item.getAttribute('data-field');
                const title = item.querySelector('span').innerText.trim();
                const visible = item.querySelector('input').checked;
                newOrder.push({ field: field, title: title, visible: visible });
            });

            let allColumns = variableTable.getColumns().map(col => col.getDefinition());
            let fixedColumns = allColumns.filter(col => col.field === 'id');
            let newColumns = newOrder.map(col => {
                let existingColumn = variableTable.getColumn(col.field);
                return existingColumn ? existingColumn.getDefinition() : { title: col.title, field: col.field, visible: col.visible };
            });

            newColumns = [...newColumns, ...fixedColumns];
            variableTable.setColumns(newColumns);

            const actionColumn = TableFields.find(col => col.field === 'id');
            TableFields = newColumns;
            if (actionColumn && !TableFields.find(col => col.field === 'id')) {
                TableFields.push(actionColumn);
            }

            populateCheckbox();
        }

        function showHideColumn(colName) {
            variableTable.toggleColumn(colName);
        }

        function setupColumnFilterSave() {
            $("#saveVariablesFilter").on("click", function () {
                var colDefs = variableTable.getColumnDefinitions();

                $(".variables-column").each(function () {
                    var field = $(this).val();
                    var isVisible = $(this).is(":checked");

                    colDefs.forEach(function (colDef) {
                        if (colDef.field === field) {
                            colDef.visible = isVisible;
                        }
                    });
                });

                var filteredColDefs = colDefs.filter(colDef => colDef.field !== 'id');
                var finaldata = { colDefs: filteredColDefs };
                var jsonData = JSON.stringify(finaldata);

                console.log("Saving column filter:", jsonData);

                $.ajax({
                    url: '@Url.Action("ColumnFilterCreation", "ColumnFilter")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ keyValue: jsonData, type: 'Variables' }),
                    success: function (response) {
                        console.log("Save response:", response);
                        if (response.Success === 1 || response.success === 1 || response.Success === true || response.success === true) {
                            toastr.success(response.Message || response.message || "Filter saved successfully", "Success", { "toastClass": "toast-green" });
                            $('#dropdownMenuButton1').dropdown('hide');
                        } else {
                            toastr.error(response.Message || response.message || "Unknown error", "Error");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Save error:", xhr.responseText, status, error);
                        try {
                            var errResponse = JSON.parse(xhr.responseText);
                            toastr.error(errResponse.Message || errResponse.message || "Error saving filter settings.", "Error");
                        } catch (e) {
                            toastr.error("Error saving filter settings.", "Error");
                        }
                    }
                });
            });
        }

        function DeleteFilter_Variables(data) {
            $.ajax({
                url: '@Url.Action("DeleteColumnFilter", "ColumnFilter")',
                type: "GET",
                data: { type: data },
                success: function (response) {
                    console.log("Delete response:", response);
                    if (response.Success == 1 || response.success == 1) {
                        toastr.success(response.Message || response.message || "Deleted successfully", "Success", { "toastClass": "toast-green" });
                        VariablesGear();
                    } else {
                        toastr.error(response.Message || response.message || "Error deleting filter", "Error", { "toastClass": "toast-red" });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Delete error:", xhr.responseText);
                    toastr.error("Error during delete.", "Error", { "toastClass": "toast-red" });
                }
            });
        }

        document.addEventListener("click", function (event) {
            let dropdown = document.querySelector(".gear-dropdown-variables");
            let button = document.getElementById("dropdownMenuButton1");
            if (dropdown && button && !dropdown.contains(event.target) && !button.contains(event.target)) {
                dropdown.classList.remove("show");
            }
        });

        document.querySelector(".gear-dropdown-variables").addEventListener("click", function (event) {
            event.stopPropagation();
        });

        function initializeVariableTable() {
            variableTable = new Tabulator("#variableTable", {
                ajaxURL: '@Url.Action("GetVariablesData", "Variables")',
                ajaxParams: function() {
                    return {
                        search: currentSearch
                    };
                },
                ajaxConfig: "GET",
                ajaxFiltering: true,
                ajaxSorting: true,
                pagination: "remote",
                paginationSize: 10,
                paginationSizeSelector: [10, 25, 50, 100],
                paginationButtonCount: 5,
                movableColumns: true,
                resizableRows: false,
                layout: "fitColumns",
                initialSort: [
                    { column: "createdAt", dir: "desc" }
                ],
                ajaxResponse: function(url, params, response) {
                    console.log("Response type:", typeof response);
                    console.log("Response received:", response);

                    if (typeof response === 'string') {
                        try {
                            response = JSON.parse(response);
                        } catch(e) {
                            console.error("Failed to parse JSON:", e);
                            return [];
                        }
                    }

                    var table = this;
                    if (response.total && table.modules && table.modules.pagination) {
                        table.modules.pagination._setTotal(response.total);
                    }

                    return response.data || [];
                },
                columns: TableFields
            });
        }

        function setupSearchFilter() {
            document.getElementById('searchInput').addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentSearch = e.target.value;
                    variableTable.setData();
                }, 300);
            });
        }

        function setupExportButtons() {
            document.getElementById('exportCsvBtn').addEventListener('click', function() {
                variableTable.download("csv", "variables_export.csv");
            });

            document.getElementById('exportExcelBtn').addEventListener('click', function() {
                variableTable.download("xlsx", "variables_export.xlsx", { sheetName: "Variables" });
            });

            document.getElementById('exportPdfBtn').addEventListener('click', function() {
                variableTable.download("pdf", "variables_export.pdf");
            });
        }

        function loadTypes() {
            console.log('Loading types with Select2...');
            
            ResetSelected('#variableType', 'Select Type');
            
            select2Initializer(
                '#variableType',
                '@Url.Action("SearchType", "Variables")',
                '',
                '#variableOffcanvas'
            );
            
            console.log('Select2 initialized for types');
        }

        function openCreateModal() {
            document.getElementById('variableOffcanvasLabel').textContent = 'Add Variable';
            document.getElementById('formAction').value = 'create';
            document.getElementById('variableForm').reset();
            document.getElementById('variableId').value = '';
            document.getElementById('isActiveRow').style.display = 'none';
            document.getElementById('variableSortOrder').value = 0;
            document.getElementById('variableIsActive').value = 'true';
            document.getElementById('submitBtn').textContent = 'Create Variable';
            clearErrors();

            if ($('#variableType').hasClass('select2-hidden-accessible')) {
                $('#variableType').select2('destroy');
            }
            ResetSelected('#variableType', 'Select Type');
            loadTypes();

            variableOffcanvas = new bootstrap.Offcanvas(document.getElementById('variableOffcanvas'));
            variableOffcanvas.show();
        }

        function openEditModal(id, type, value, description, sortOrder, isActive) {
            document.getElementById('variableOffcanvasLabel').textContent = 'Edit Variable';
            document.getElementById('formAction').value = 'edit';
            document.getElementById('variableId').value = id;
            document.getElementById('variableValue').value = value;
            document.getElementById('variableDescription').value = description || '';
            document.getElementById('variableSortOrder').value = sortOrder;
            document.getElementById('variableIsActive').value = isActive.toString();
            document.getElementById('isActiveRow').style.display = 'block';
            document.getElementById('submitBtn').textContent = 'Update Variable';
            clearErrors();

            if ($('#variableType').hasClass('select2-hidden-accessible')) {
                $('#variableType').select2('destroy');
            }
            ResetSelected('#variableType', 'Select Type');
            loadTypes();

            if (type) {
                $.ajax({
                    url: '@Url.Action("SearchType", "Variables")',
                    type: 'GET',
                    data: { searchTerm: '', selectedvalue: type },
                    success: function(data) {
                        const selectedType = data.find(x => x.selected === true);
                        if (selectedType) {
                            DefaultSelected('#variableType', selectedType.id, selectedType.text);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error fetching type for edit:', error);
                    }
                });
            }

            variableOffcanvas = new bootstrap.Offcanvas(document.getElementById('variableOffcanvas'));
            variableOffcanvas.show();
        }

        function clearErrors() {
            document.querySelectorAll('.text-danger').forEach(el => {
                el.textContent = '';
            });
        }

        document.getElementById('variableForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearErrors();

            const formData = new FormData(this);
            const action = document.getElementById('formAction').value;
            const id = document.getElementById('variableId').value;
            
            const url = action === 'create' 
                ? '@Url.Action("Save", "Variables")'
                : '@Url.Action("Save", "Variables")';

            const model = {
                Id: id ? id : null,
                Type: document.getElementById('variableType').value,
                Value: document.getElementById('variableValue').value,
                Description: document.getElementById('variableDescription').value || null,
                SortOrder: parseInt(document.getElementById('variableSortOrder').value) || 0,
                IsActive: document.getElementById('variableIsActive').value === 'true'
            };

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(model)
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    if (variableOffcanvas) {
                        variableOffcanvas.hide();
                    }

                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Variable saved successfully!',
                        timer: 1500,
                        showConfirmButton: false
                    });

                    document.getElementById('variableForm').reset();
                    document.getElementById('variableId').value = '';
                    
                    variableTable.setData();
                } else {
                    const errors = result.errors;
                    if (errors) {
                        for (const [key, value] of Object.entries(errors)) {
                            if (key === '__global') {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: value.join(' ')
                                });
                            } else {
                                const errorEl = document.getElementById(key.charAt(0).toLowerCase() + key.slice(1) + 'Error');
                                if (errorEl) {
                                    errorEl.textContent = value.join(' ');
                                }
                            }
                        }
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: result.message || 'An error occurred'
                        });
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'An error occurred while saving the variable.'
                });
            }
        });

        function deleteVariable(id, name) {
            Swal.fire({
                title: 'Delete Variable?',
                text: `Are you sure you want to delete "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                    fetch(`@Url.Action("Delete", "Variables")/${id}`, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Variable deleted successfully!',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            variableTable.setData();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: result.message || 'Failed to delete variable.'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: 'An error occurred while deleting the variable.'
                        });
                    });
                }
            });
        }
    </script>
}
