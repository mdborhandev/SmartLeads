@{
    ViewData["Title"] = "Designation List";
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">All Designations</h5>
        <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#designationOffcanvas" onclick="openCreateModal()">
            <i class="bx bx-plus me-1"></i> Add Designation
        </button>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bx bx-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-3 align-items-center mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by name or description..." />
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <!-- Column Filter Dropdown -->
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-outline-primary" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-cog"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end gear-dropdown-designations" aria-labelledby="dropdownMenuButton1">
                            <div class="row p-4 main-dropdown-size overflow-hidden">
                                <div class="col">
                                    <span class="fw-bold ms-3">Columns</span>
                                    <hr class="m-0 w-75 ms-3 w-sm-50" />
                                    <ul class="list-unstyled" id="DesignationsColumnList">
                                        <!-- Column checkboxes will be populated here -->
                                    </ul>
                                </div>
                            </div>
                            <div class="d-flex">
                                <div class="p-4">
                                    <button id="saveDesignationsFilter" class="btn btn-outline-primary">Save Filter</button>
                                </div>
                                <div class="p-4">
                                    <button id="deleteDesignationsFilter" class="btn btn-outline-danger" onclick="DeleteFilter_Designations('Designations')">Remove Filter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Export Dropdown -->
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-export me-1"></i> Export
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button type="button" class="dropdown-item" id="exportCsvBtn">CSV</button></li>
                            <li><button type="button" class="dropdown-item" id="exportExcelBtn">Excel</button></li>
                            <li><button type="button" class="dropdown-item" id="exportPdfBtn">PDF</button></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div id="designationTable"></div>
    </div>
</div>

<!-- Designation Offcanvas -->
<div class="offcanvas offcanvas-end w-100" tabindex="-1" id="designationOffcanvas" aria-labelledby="designationOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="designationOffcanvasLabel">Add Designation</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="designationForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="designationId" name="Id" />
            <input type="hidden" id="formAction" value="create" />

            <h6 class="mb-3">Designation Information</h6>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="desigName" class="form-label">Designation Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="desigName" name="Name" required />
                    <span class="text-danger" id="nameError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="desigDepartmentId" class="form-label">Department <span class="text-danger">*</span></label>
                    <select class="form-select" id="desigDepartmentId" name="DepartmentId" required>
                        <option value="">Select Department</option>
                    </select>
                    <span class="text-danger" id="departmentError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-12 mb-3">
                    <label for="desigDescription" class="form-label">Description</label>
                    <textarea class="form-control" id="desigDescription" name="Description" rows="3"></textarea>
                </div>
            </div>

            <div class="row" id="isActiveRow" style="display: none;">
                <div class="col-12 mb-3">
                    <label for="desigIsActive" class="form-label">Status</label>
                    <select class="form-select" id="desigIsActive" name="IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-primary" id="submitBtn">Create Designation</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let designationOffcanvas = null;
        let designationTable = null;
        let searchTimeout = null;
        let currentSearch = '';

        // Define table columns with visibility settings
        var TableFields = [
            {
                title: "#",
                field: "rownum",
                formatter: "rownum",
                hozAlign: "center",
                headerSort: false,
                width: 50,
                visible: true
            },
            {
                title: "Name",
                field: "name",
                hozAlign: "left",
                visible: true
            },
            {
                title: "Department",
                field: "departmentName",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Description",
                field: "description",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Status",
                field: "isActive",
                hozAlign: "center",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-secondary">Inactive</span>';
                }
            },
            {
                title: "Actions",
                field: "id",
                hozAlign: "center",
                headerSort: false,
                download: false,
                print: false,
                frozen: true,
                visible: true,
                formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const id = row.id || '';
                    const name = (row.name || '').toString().replace(/'/g, "\\'");
                    const departmentId = row.departmentId || '';
                    const description = (row.description || '').toString().replace(/'/g, "\\'");
                    const isActive = row.isActive || false;

                    return `
                        <button class="btn btn-sm btn-primary me-2"
                            onclick="openEditModal(
                                '${id}',
                                '${name}',
                                '${departmentId}',
                                '${description}',
                                ${isActive}
                            )">
                            <i class="bx bx-edit"></i> Edit
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteDesignation('${id}', '${name}')">
                            <i class="bx bx-trash"></i> Delete
                        </button>
                    `;
                }
            }
        ];

        // Initialize offcanvas and table on page load
        document.addEventListener('DOMContentLoaded', function() {
            designationOffcanvas = new bootstrap.Offcanvas(document.getElementById('designationOffcanvas'));

            // Load column filter settings and initialize table
            DesignationsGear();
        });

        // Load column filter settings and initialize table
        function DesignationsGear() {
            $.ajax({
                url: '@Url.Action("GetFilteredColumn", "ColumnFilter")',
                type: 'GET',
                data: { type: 'Designations' },
                success: function (response) {
                    console.log("GetFilteredColumn response:", response);

                    if ((response.Success == 1 || response.success == 1) && response.data && response.data.keyValue) {
                        try {
                            const savedData = JSON.parse(response.data.keyValue);
                            console.log("Parsed saved data:", savedData);

                            if (savedData.colDefs && Array.isArray(savedData.colDefs)) {
                                // Reorder TableFields based on saved order
                                const newTableFields = [];

                                // First add columns in saved order
                                savedData.colDefs.forEach(savedCol => {
                                    const tableCol = TableFields.find(col => col.field === savedCol.field);
                                    if (tableCol) {
                                        tableCol.visible = savedCol.visible !== undefined ? savedCol.visible : true;
                                        newTableFields.push(tableCol);
                                    }
                                });

                                // Then add any new columns that weren't in saved config (like Actions)
                                TableFields.forEach(col => {
                                    if (!newTableFields.find(c => c.field === col.field)) {
                                        newTableFields.push(col);
                                    }
                                });

                                // Replace TableFields with reordered array
                                TableFields.length = 0;
                                TableFields.push(...newTableFields);

                                console.log("Updated TableFields:", TableFields);
                            }
                        } catch (e) {
                            console.error("Error parsing saved columns:", e);
                        }
                    }
                    populateCheckbox();
                    initializeDesignationTable();
                    setupSearchFilter();
                    setupExportButtons();
                    setupColumnFilterSave();
                },
                error: function (error) {
                    console.error("Error fetching column settings:", error);
                    populateCheckbox();
                    initializeDesignationTable();
                    setupSearchFilter();
                    setupExportButtons();
                    setupColumnFilterSave();
                }
            });
        }

        // Populate column filter checkboxes
        function populateCheckbox() {
            let items = TableFields
                .filter(x => x.field !== 'id') // Exclude actions column
                .map(x => {
                    return `
                        <li class="d-flex justify-content-between align-items-center px-3 py-1 draggable-item" data-field="${x.field}">
                            <span class="d-flex align-items-center">
                                <i class="bx bx-menu me-2 handle" style="cursor: move;"></i> ${x.title}
                            </span>
                            <div class="form-check form-switch">
                                <input class="form-check-input toggle-column designations-column" type="checkbox" role="switch"
                                       id="${x.field}" value="${x.field}" ${x.visible ? 'checked' : ''}
                                       onclick="showHideColumn('${x.field}')">
                            </div>
                        </li>`;
                });

            const columnList = document.getElementById('DesignationsColumnList');
            columnList.innerHTML = items.join('');
            enableDragAndDrop();
        }

        // Enable drag and drop for column ordering
        function enableDragAndDrop() {
            new Sortable(document.getElementById('DesignationsColumnList'), {
                animation: 200,
                handle: '.handle',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'sortable-drag',
                forceFallback: true,
                fallbackTolerance: 5,
                scroll: true,
                scrollSensitivity: 30,
                scrollSpeed: 10,
                onEnd: function (evt) {
                    updateColumnOrder();
                }
            });
        }

        // Update column order based on drag and drop
        function updateColumnOrder() {
            let newOrder = [];
            document.querySelectorAll('#DesignationsColumnList .draggable-item').forEach(item => {
                const field = item.getAttribute('data-field');
                const title = item.querySelector('span').innerText.trim();
                const visible = item.querySelector('input').checked;
                newOrder.push({ field: field, title: title, visible: visible });
            });

            let allColumns = designationTable.getColumns().map(col => col.getDefinition());
            let fixedColumns = allColumns.filter(col => col.field === 'id');
            let newColumns = newOrder.map(col => {
                let existingColumn = designationTable.getColumn(col.field);
                return existingColumn ? existingColumn.getDefinition() : { title: col.title, field: col.field, visible: col.visible };
            });

            newColumns = [...newColumns, ...fixedColumns];
            designationTable.setColumns(newColumns);

            // Update TableFields array to match new order (for saving)
            const actionColumn = TableFields.find(col => col.field === 'id');
            TableFields = newColumns;
            if (actionColumn && !TableFields.find(col => col.field === 'id')) {
                TableFields.push(actionColumn);
            }

            // Re-populate checkboxes
            populateCheckbox();
        }

        // Show/hide individual column
        function showHideColumn(colName) {
            designationTable.toggleColumn(colName);
        }

        // Save column filter settings
        function setupColumnFilterSave() {
            $("#saveDesignationsFilter").on("click", function () {
                var colDefs = designationTable.getColumnDefinitions();

                $(".designations-column").each(function () {
                    var field = $(this).val();
                    var isVisible = $(this).is(":checked");

                    colDefs.forEach(function (colDef) {
                        if (colDef.field === field) {
                            colDef.visible = isVisible;
                        }
                    });
                });

                var filteredColDefs = colDefs.filter(colDef => colDef.field !== 'id');
                var finaldata = { colDefs: filteredColDefs };
                var jsonData = JSON.stringify(finaldata);

                console.log("Saving column filter:", jsonData);

                $.ajax({
                    url: '@Url.Action("ColumnFilterCreation", "ColumnFilter")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ keyValue: jsonData, type: 'Designations' }),
                    success: function (response) {
                        console.log("Save response:", response);
                        if (response.Success === 1 || response.success === 1 || response.Success === true || response.success === true) {
                            toastr.success(response.Message || response.message || "Filter saved successfully", "Success", { "toastClass": "toast-green" });
                            $('#dropdownMenuButton1').dropdown('hide');
                        } else {
                            toastr.error(response.Message || response.message || "Unknown error", "Error");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Save error:", xhr.responseText, status, error);
                        try {
                            var errResponse = JSON.parse(xhr.responseText);
                            toastr.error(errResponse.Message || errResponse.message || "Error saving filter settings.", "Error");
                        } catch (e) {
                            toastr.error("Error saving filter settings.", "Error");
                        }
                    }
                });
            });
        }

        // Delete column filter settings
        function DeleteFilter_Designations(data) {
            $.ajax({
                url: '@Url.Action("DeleteColumnFilter", "ColumnFilter")',
                type: "GET",
                data: { type: data },
                success: function (response) {
                    console.log("Delete response:", response);
                    if (response.Success == 1 || response.success == 1) {
                        toastr.success(response.Message || response.message || "Deleted successfully", "Success", { "toastClass": "toast-green" });
                        DesignationsGear();
                    } else {
                        toastr.error(response.Message || response.message || "Error deleting filter", "Error", { "toastClass": "toast-red" });
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Delete error:", xhr.responseText);
                    toastr.error("Error during delete.", "Error", { "toastClass": "toast-red" });
                }
            });
        }

        // Close dropdown when clicking outside
        document.addEventListener("click", function (event) {
            let dropdown = document.querySelector(".gear-dropdown-designations");
            let button = document.getElementById("dropdownMenuButton1");
            if (dropdown && button && !dropdown.contains(event.target) && !button.contains(event.target)) {
                dropdown.classList.remove("show");
            }
        });

        document.querySelector(".gear-dropdown-designations").addEventListener("click", function (event) {
            event.stopPropagation();
        });

        // Initialize Tabulator with server-side pagination
        function initializeDesignationTable() {
            designationTable = new Tabulator("#designationTable", {
                ajaxURL: '@Url.Action("GetDesignationsData", "Designations")',
                ajaxParams: function() {
                    return {
                        search: currentSearch
                    };
                },
                ajaxConfig: "GET",
                ajaxFiltering: true,
                ajaxSorting: true,
                pagination: "remote",
                paginationSize: 10,
                paginationSizeSelector: [10, 25, 50, 100],
                paginationButtonCount: 5,
                movableColumns: true,
                resizableRows: false,
                layout: "fitColumns",
                initialSort: [
                    { column: "createdAt", dir: "desc" }
                ],
                ajaxResponse: function(url, params, response) {
                    console.log("Response type:", typeof response);
                    console.log("Response received:", response);

                    // Check if response is a string (not parsed)
                    if (typeof response === 'string') {
                        try {
                            response = JSON.parse(response);
                        } catch(e) {
                            console.error("Failed to parse JSON:", e);
                            return [];
                        }
                    }

                    // Set pagination total for Tabulator 5.x
                    var table = this;
                    if (response.total && table.modules && table.modules.pagination) {
                        table.modules.pagination._setTotal(response.total);
                    }

                    // For Tabulator 5.x remote pagination, return only the data array
                    return response.data || [];
                },
                columns: TableFields
            });
        }

        // Setup search filter with debounce
        function setupSearchFilter() {
            document.getElementById('searchInput').addEventListener('input', function(e) {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    currentSearch = e.target.value;
                    designationTable.setData();
                }, 300);
            });
        }

        // Setup export buttons
        function setupExportButtons() {
            document.getElementById('exportCsvBtn').addEventListener('click', function() {
                designationTable.download("csv", "designations_export.csv");
            });

            document.getElementById('exportExcelBtn').addEventListener('click', function() {
                designationTable.download("xlsx", "designations_export.xlsx", { sheetName: "Designations" });
            });

            document.getElementById('exportPdfBtn').addEventListener('click', function() {
                designationTable.download("pdf", "designations_export.pdf");
            });
        }

        // Load departments dropdown with Select2
        function loadDepartments() {
            console.log('Loading departments with Select2...');
            
            // Clear any existing options first
            ResetSelected('#desigDepartmentId', 'Select Department');
            
            // Verify element exists
            if ($('#desigDepartmentId').length === 0) {
                console.error('Department dropdown element not found!');
                return;
            }
            
            console.log('Initializing Select2 on #desigDepartmentId');
            
            // Use select2Initializer for consistent Select2 implementation
            select2Initializer(
                '#desigDepartmentId',
                '@Url.Action("SearchDepartment", "Departments")',
                '',
                '#designationOffcanvas'
            );
            
            console.log('Select2 initialized');
        }

        // Load dropdowns on page load
        $(document).ready(function() {
            loadDepartments();
        });

        // Open Create Modal
        function openCreateModal() {
            document.getElementById('designationOffcanvasLabel').textContent = 'Add Designation';
            document.getElementById('formAction').value = 'create';
            document.getElementById('designationForm').reset();
            document.getElementById('designationId').value = '';
            document.getElementById('isActiveRow').style.display = 'none';
            document.getElementById('submitBtn').textContent = 'Create Designation';
            clearErrors();

            // Destroy existing Select2 if it exists
            if ($('#desigDepartmentId').hasClass('select2-hidden-accessible')) {
                $('#desigDepartmentId').select2('destroy');
            }

            // Reset the select options
            ResetSelected('#desigDepartmentId', 'Select Department');

            // Reinitialize Select2 for create mode
            select2Initializer(
                '#desigDepartmentId',
                '@Url.Action("SearchDepartment", "Departments")',
                '',
                '#designationOffcanvas'
            );

            // Show the offcanvas
            designationOffcanvas = new bootstrap.Offcanvas(document.getElementById('designationOffcanvas'));
            designationOffcanvas.show();
        }

        // Open Edit Modal
        function openEditModal(id, name, departmentId, description, isActive) {
            document.getElementById('designationOffcanvasLabel').textContent = 'Edit Designation';
            document.getElementById('formAction').value = 'edit';
            document.getElementById('designationId').value = id;
            document.getElementById('desigName').value = name;
            document.getElementById('desigDescription').value = description || '';
            document.getElementById('isActiveRow').style.display = 'block';
            document.getElementById('desigIsActive').value = isActive.toString();
            document.getElementById('submitBtn').textContent = 'Update Designation';
            clearErrors();

            // Destroy existing Select2 if it exists
            if ($('#desigDepartmentId').hasClass('select2-hidden-accessible')) {
                $('#desigDepartmentId').select2('destroy');
            }

            // Reset options before reinitializing Select2
            ResetSelected('#desigDepartmentId', 'Select Department');

            // Reinitialize Select2
            select2Initializer(
                '#desigDepartmentId',
                '@Url.Action("SearchDepartment", "Departments")',
                '',
                '#designationOffcanvas'
            );

            // Set the selected value after initialization
            if (departmentId) {
                // Make an AJAX call to get the department name
                $.ajax({
                    url: '@Url.Action("SearchDepartment", "Departments")',
                    type: 'GET',
                    data: { searchTerm: '', selectedvalue: departmentId },
                    success: function(data) {
                        console.log('Edit mode - Selected department data:', data);
                        // Find the selected department
                        const selectedDept = data.find(d => d.selected === true);
                        if (selectedDept) {
                            DefaultSelected('#desigDepartmentId', selectedDept.id, selectedDept.text);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error fetching department for edit:', error);
                    }
                });
            }

            // Show the offcanvas
            designationOffcanvas = new bootstrap.Offcanvas(document.getElementById('designationOffcanvas'));
            designationOffcanvas.show();
        }

        // Clear validation errors
        function clearErrors() {
            document.querySelectorAll('.text-danger').forEach(el => {
                el.textContent = '';
            });
        }

        // Form Submit Handler
        document.getElementById('designationForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearErrors();

            const formData = new FormData(this);
            const action = document.getElementById('formAction').value;
            const id = document.getElementById('designationId').value;
            
            const url = action === 'create' 
                ? '@Url.Action("Create", "Designations")'
                : '@Url.Action("Edit", "Designations")/' + id;

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // Close offcanvas
                    if (designationOffcanvas) {
                        designationOffcanvas.hide();
                    }

                    // Show success message
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Designation saved successfully!',
                        timer: 1500,
                        showConfirmButton: false
                    });

                    // Reset form
                    document.getElementById('designationForm').reset();
                    document.getElementById('designationId').value = '';
                    
                    // Reload table data without refreshing the page
                    designationTable.setData();
                } else {
                    // Handle validation errors
                    const errors = result.errors;
                    if (errors) {
                        for (const [key, value] of Object.entries(errors)) {
                            if (key === '__global') {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error!',
                                    text: value.join(' ')
                                });
                            } else {
                                const errorEl = document.getElementById(key.charAt(0).toLowerCase() + key.slice(1) + 'Error');
                                if (errorEl) {
                                    errorEl.textContent = value.join(' ');
                                }
                            }
                        }
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'An error occurred while saving the designation.'
                });
            }
        });

        // Delete Designation
        function deleteDesignation(id, name) {
            Swal.fire({
                title: 'Delete Designation?',
                text: `Are you sure you want to delete "${name}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                    fetch(`@Url.Action("Delete", "Designations")/${id}`, {
                        method: 'POST',
                        body: formData
                    })
                    .then(response => response.json())
                    .then(result => {
                        if (result.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Designation deleted successfully!',
                                timer: 1500,
                                showConfirmButton: false
                            });
                            // Reload table data without refreshing the page
                            designationTable.setData();
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: result.message || 'Failed to delete designation.'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: 'An error occurred while deleting the designation.'
                        });
                    });
                }
            });
        }
    </script>
