@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>No Company Access - SmartLeads</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        
        .no-company-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 600px;
            width: 100%;
            overflow: hidden;
            animation: slideUp 0.6s ease-out;
        }
        
        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 30px;
            text-align: center;
        }
        
        .card-header i {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.9;
        }
        
        .card-header h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
        }
        
        .card-header p {
            font-size: 15px;
            opacity: 0.9;
            margin: 0;
        }
        
        .card-body {
            padding: 40px 30px;
        }
        
        .alert-info {
            background: #e7f3ff;
            border: 1px solid #b3d9ff;
            color: #004085;
            padding: 15px 20px;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        
        .alert-info i {
            margin-right: 10px;
        }
        
        .option-card {
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .option-card:hover {
            border-color: #667eea;
            background: #f8f9ff;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.2);
        }
        
        .option-card i {
            font-size: 32px;
            color: #667eea;
            margin-bottom: 15px;
        }
        
        .option-card h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 10px;
            color: #333;
        }
        
        .option-card p {
            color: #666;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 15px;
        }
        
        .form-control {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 12px 15px;
            font-size: 15px;
        }
        
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }
        
        .btn-join {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        
        .btn-join:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }
        
        .btn-create {
            background: white;
            border: 2px solid #667eea;
            color: #667eea;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            transition: all 0.2s ease;
        }
        
        .btn-create:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }
        
        .divider {
            text-align: center;
            margin: 25px 0;
            position: relative;
        }
        
        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 100%;
            height: 1px;
            background: #e0e0e0;
        }
        
        .divider span {
            background: white;
            padding: 0 15px;
            position: relative;
            color: #999;
            font-size: 14px;
        }
        
        .logout-link {
            display: block;
            text-align: center;
            margin-top: 25px;
            color: #666;
            text-decoration: none;
            font-size: 14px;
        }
        
        .logout-link:hover {
            color: #667eea;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="no-company-card">
        <!-- Card Header -->
        <div class="card-header">
            <i class="fas fa-building"></i>
            <h1>No Company Access</h1>
            <p>You're not associated with any company yet</p>
        </div>
        
        <!-- Card Body -->
        <div class="card-body">
            <div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle"></i>
                <strong>Welcome!</strong> To access SmartLeads features, you need to join or create a company.
            </div>
            
            <!-- Option 1: Join Company -->
            <form asp-action="JoinCompany" method="post">
                @Html.AntiForgeryToken()
                <div class="option-card">
                    <i class="fas fa-door-open"></i>
                    <h3>Join Existing Company</h3>
                    <p>Enter your company code to join. You can get this code from your company administrator.</p>
                    <input type="text" name="companyCode" class="form-control mb-3" placeholder="Enter company code" required />
                    <button type="submit" class="btn btn-join">
                        <i class="fas fa-arrow-right"></i> Join Company
                    </button>
                </div>
            </form>
            
            <div class="divider">
                <span>OR</span>
            </div>
            
            <!-- Option 2: Create Company -->
            <form asp-action="CreateCompany" method="post">
                @Html.AntiForgeryToken()
                <div class="option-card">
                    <i class="fas fa-plus-circle"></i>
                    <h3>Create New Company</h3>
                    <p>Start fresh by creating your own company. You'll be the administrator and can invite others.</p>
                    <button type="submit" class="btn btn-create">
                        <i class="fas fa-plus"></i> Create Company
                    </button>
                </div>
            </form>
            
            <!-- Logout Link -->
            <a asp-action="Logout" asp-controller="Auth" class="logout-link" method="post">
                <i class="fas fa-sign-out-alt"></i> Sign out
            </a>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Show error message if exists
        document.addEventListener('DOMContentLoaded', function() {
            const errorMessage = '@TempData["ErrorMessage"]';
            if (errorMessage) {
                alert(errorMessage);
            }
        });
    </script>
</body>
</html>
