@model SmartLeads.Domain.DTOs.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<!-- Forgot Password Form Card -->
<div class="auth-card">
    <!-- Card Header -->
    <div class="text-center mb-4">
        <h2 class="h4 fw-bold mb-2">Forgot your password? 🔒</h2>
        <p class="text-muted">Enter your email and we'll send you a link to reset your password</p>
    </div>

    <form id="forgot-password">
        @Html.AntiForgeryToken()

        <div id="error-message" class="alert alert-danger" role="alert" style="display: none;"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <button id="forgot-password-submit" type="submit" class="btn btn-primary w-100 mb-3">
            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
            <span class="button-text">Send Reset Link</span>
        </button>

        <div class="text-center mb-3">
            <span class="text-muted">Remember your password?</span>
            <a asp-action="Login" class="text-decoration-none ms-2 fw-semibold">Sign in now</a>
        </div>

        <div class="text-center">
            <a asp-action="Landing" asp-controller="Home" class="text-decoration-none text-muted small">
                ← Back to home
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/PartialView/_ValidationScriptsPartial.cshtml" />
    <script>
        $(document).ready(function() {
            $('#forgot-password').on('submit', function(e) {
                e.preventDefault();

                var $form = $(this);
                var $button = $('#forgot-password-submit');
                var $spinner = $button.find('.spinner-border');
                var $buttonText = $button.find('.button-text');
                var $errorMessage = $('#error-message');

                // Validate form
                if (!$form.valid()) {
                    return false;
                }

                // Show loading state
                $button.prop('disabled', true);
                $spinner.removeClass('d-none');
                $buttonText.text('Sending...');
                $errorMessage.hide();

                // Get anti-forgery token
                var token = $form.find('input[name="__RequestVerificationToken"]').val();

                // Send AJAX request
                $.ajax({
                    url: '@Url.Action("ApiForgotPassword", "Auth")',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    data: JSON.stringify({
                        email: $('#Email').val()
                    }),
                    success: function(response) {
                        // Show success message
                        toastr.success(response.message, 'Success');

                        // Redirect to confirmation page
                        setTimeout(function() {
                            window.location.href = '@Url.Action("ForgotPasswordConfirmation", "Auth")';
                        }, 1000);
                    },
                    error: function(xhr) {
                        var response = xhr.responseJSON;
                        $errorMessage.text(response?.message || 'An error occurred. Please try again.');
                        $errorMessage.show();

                        // Reset button state
                        $button.prop('disabled', false);
                        $spinner.addClass('d-none');
                        $buttonText.text('Send Reset Link');
                    }
                });

                return false;
            });
        });
    </script>
}
