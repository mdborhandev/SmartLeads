@model SmartLeads.Domain.DTOs.LoginViewModel

@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<!-- Login Form Card -->
<div class="auth-card">
    <!-- Card Header -->
    <div class="text-center mb-4">
        <h2 class="h4 fw-bold mb-2">Welcome back! 👋</h2>
        <p class="text-muted">Sign in to your SmartLeads account</p>
    </div>

    <form id="account" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="EmailOrUsername" class="form-label">Email or Username</label>
            <input asp-for="EmailOrUsername" class="form-control" autocomplete="username" aria-required="true" placeholder="Enter your email or username" />
            <span asp-validation-for="EmailOrUsername" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                <input class="form-check-input" asp-for="RememberMe" type="checkbox" id="rememberMe">
                <label class="form-check-label" asp-for="RememberMe">
                    Remember me
                </label>
            </div>
            <a asp-action="ForgotPassword" class="text-decoration-none">Forgot Password?</a>
        </div>

        <button id="login-submit" type="submit" class="btn btn-primary w-100 mb-3">
            Sign in
        </button>

        <div class="text-center mb-3">
            <span class="text-muted">Don't have an account?</span>
            <a asp-action="Register" class="text-decoration-none ms-2 fw-semibold">Create one now</a>
        </div>

        <div class="text-center">
            <a asp-action="Landing" asp-controller="Home" class="text-decoration-none text-muted small">
                ← Back to home
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/PartialView/_ValidationScriptsPartial.cshtml" />
}
