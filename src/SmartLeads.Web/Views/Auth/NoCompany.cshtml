@{
    Layout = "_UserCompanyLayout";
    ViewData["Title"] = "Company Access";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="card mb-4">
            <div class="card-body text-center py-5">
                <div class="avatar avatar-xl mx-auto mb-3">
                    <span class="avatar-initial rounded bg-label-primary">
                        <i class="bx bx-buildings fs-2"></i>
                    </span>
                </div>
                <h3 class="mb-2">Company Access Required</h3>
                <p class="text-body-secondary mb-0">
                    Your account is active, but you need to join an existing company or create a new one before continuing.
                </p>
            </div>
        </div>

        <div class="alert alert-info" role="alert">
            <i class="bx bx-info-circle me-1"></i>
            Use a valid company code to join an existing workspace, or create a new company to start your setup.
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-1">Join Existing Company</h5>
                        <p class="card-subtitle text-body-secondary mb-0">Enter the code shared by your administrator.</p>
                    </div>
                    <div class="card-body">
                        <form asp-action="JoinCompany" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="companyCode" class="form-label">Company Code</label>
                                <input id="companyCode" name="companyCode" type="text" class="form-control" placeholder="Enter company code" required />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bx bx-right-arrow-alt me-1"></i>Join Company
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-1">Create New Company</h5>
                        <p class="card-subtitle text-body-secondary mb-0">Set up a new company and become its first administrator.</p>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="mb-4">
                            <div class="d-flex align-items-start mb-3">
                                <span class="badge bg-label-primary me-2">1</span>
                                <span>Create your company workspace</span>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <span class="badge bg-label-primary me-2">2</span>
                                <span>Configure your admin account</span>
                            </div>
                            <div class="d-flex align-items-start">
                                <span class="badge bg-label-primary me-2">3</span>
                                <span>Invite team members later</span>
                            </div>
                        </div>
                        <form asp-action="CreateCompany" method="post" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-primary w-100">
                                <i class="bx bx-plus me-1"></i>Create Company
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const errorMessage = '@TempData["ErrorMessage"]';
            if (errorMessage) {
                toastr.error(errorMessage);
            }
        });
    </script>
}
