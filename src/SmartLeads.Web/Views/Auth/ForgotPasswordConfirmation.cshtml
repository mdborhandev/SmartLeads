@{
    ViewData["Title"] = "Reset Link Sent";
    Layout = "_AuthLayout";
}

<!-- Forgot Password Confirmation Card -->
<div class="auth-card">
    <!-- Card Header -->
    <div class="text-center mb-4">
        <h2 class="h4 fw-bold mb-2">Check your email 📧</h2>
        <p class="text-muted">We've sent you a password reset link</p>
    </div>

    <div class="text-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-envelope-check text-success mb-3" viewBox="0 0 16 16">
            <path d="M2 2a2 2 0 0 0-2 2v8.01A2 2 0 0 0 2 14h5.5a.5.5 0 0 0 0-1H2a1 1 0 0 1-.966-.741l5.64-3.471L8 9.583l7-4.2V8.5a.5.5 0 0 0 1 0V4a2 2 0 0 0-2-2zm3.708 6.208L1 11.105V5.383zM1 4.217 4.708 6.5 1 8.783z"/>
            <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-1.992-1.507a.5.5 0 0 0-.716.692l1 1a.5.5 0 0 0 .708 0l2-2a.5.5 0 1 0-.708-.708z"/>
        </svg>
    </div>

    <div class="alert alert-warning" role="alert">
        <p class="mb-0"><strong>Didn't receive the email?</strong> Check your spam folder or try again.</p>
    </div>

    <button onclick="window.location.href='@Url.Action("ForgotPassword", "Auth")'" class="btn btn-primary w-100 mb-3">
        Try Again
    </button>

    <div class="text-center mb-3">
        <span class="text-muted">Remember your password?</span>
        <a asp-action="Login" class="text-decoration-none ms-2 fw-semibold">Sign in now</a>
    </div>

    <div class="text-center">
        <a asp-action="Landing" asp-controller="Home" class="text-decoration-none text-muted small">
            ← Back to home
        </a>
    </div>
</div>
