@model SmartLeads.Domain.DTOs.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<!-- Reset Password Form Card -->
<div class="auth-card">
    <!-- Card Header -->
    <div class="text-center mb-4">
        <h2 class="h4 fw-bold mb-2">Reset your password 🔑</h2>
        <p class="text-muted">Enter your new password below</p>
    </div>

    <form id="reset-password" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" disabled />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New Password</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter new password" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button id="reset-password-submit" type="submit" class="btn btn-primary w-100 mb-3">
            Reset Password
        </button>

        <div class="text-center mb-3">
            <span class="text-muted">Remember your password?</span>
            <a asp-action="Login" class="text-decoration-none ms-2 fw-semibold">Sign in now</a>
        </div>

        <div class="text-center">
            <a asp-action="Landing" asp-controller="Home" class="text-decoration-none text-muted small">
                ← Back to home
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/PartialView/_ValidationScriptsPartial.cshtml" />
}
