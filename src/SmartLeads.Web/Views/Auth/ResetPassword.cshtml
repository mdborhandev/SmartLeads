@model SmartLeads.Domain.DTOs.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<!-- Reset Password Form Card -->
<div class="login-card">
    <!-- Card Header (Inside Card - Top) -->
    @await Html.PartialAsync("_CardHeader", new ViewDataDictionary(ViewData) { { "LogoSubtitle", "Reset your password 🔑" } })

    <form id="reset-password" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <input type="hidden" asp-for="Token" />
        <input type="hidden" asp-for="Email" />

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" disabled />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">New Password</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter new password" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mb-3">
            <button id="reset-password-submit" type="submit" class="btn btn-primary w-100">Reset Password</button>
            <a asp-action="Login" class="btn btn-secondary w-100">← Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
