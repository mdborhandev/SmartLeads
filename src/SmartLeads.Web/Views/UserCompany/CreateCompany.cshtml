@model SmartLeads.Domain.DTOs.CompanyRegistrationViewModel

@{
    ViewData["Title"] = "Create Company - SmartLeads";
    Layout = "_UserCompanyLayout";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bx bx-buildings me-2"></i>Create Company
        </h5>
    </div>
    <div class="card-body">
        <form id="createCompanyForm">
            @Html.AntiForgeryToken()

            <div id="success-message" class="alert alert-success" role="alert" style="display: none; white-space: pre-line;"></div>
            <div id="error-message" class="alert alert-danger" role="alert" style="display: none; white-space: pre-line;"></div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyName" class="form-label fw-bold">Company Name <span class="text-danger">*</span></label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Enter company name" required />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyCode" class="form-label fw-bold">Company Code</label>
                    <input asp-for="CompanyCode" class="form-control" placeholder="Enter company code" />
                    <span asp-validation-for="CompanyCode" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyEmail" class="form-label fw-bold">Email</label>
                    <input asp-for="CompanyEmail" class="form-control" placeholder="name@company.com" />
                    <span asp-validation-for="CompanyEmail" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CompanyPhone" class="form-label fw-bold">Phone</label>
                    <input asp-for="CompanyPhone" class="form-control" placeholder="Enter phone number" />
                    <span asp-validation-for="CompanyPhone" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="CompanyAddress" class="form-label fw-bold">Address</label>
                    <input asp-for="CompanyAddress" class="form-control" placeholder="Enter company address" />
                    <span asp-validation-for="CompanyAddress" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="ParentCompanyId" class="form-label fw-bold">Parent Company</label>
                    <select asp-for="ParentCompanyId" class="form-select" id="parentCompanySelect">
                        <option value="">-- None (Create as Parent Company) --</option>
                    </select>
                    <span asp-validation-for="ParentCompanyId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="agreeToTerms" required />
                <label class="form-check-label" for="agreeToTerms">
                    I agree to the <a href="@Url.Action("Privacy", "Home")" target="_blank" class="text-decoration-none">Terms and Conditions</a>
                </label>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button id="create-company-submit" type="submit" class="btn btn-outline-primary">
                    <i class="bx bx-save me-1"></i> Create Company
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('createCompanyForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);
            const url = '@Url.Action("CreateCompany", "UserCompany")';

            // Validate terms checkbox
            const termsCheckbox = document.getElementById('agreeToTerms');
            if (!termsCheckbox.checked) {
                if (window.toastr) {
                    toastr.error('You must agree to the Terms and Conditions.', 'Error');
                } else {
                    document.getElementById('error-message').textContent = 'You must agree to the Terms and Conditions.';
                    document.getElementById('error-message').style.display = 'block';
                }
                return;
            }

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const result = await response.json();

                if (result.success) {
                    if (window.toastr) {
                        toastr.success(result.message || "Company created successfully", "Success", { "toastClass": "toast-green" });
                    } else {
                        document.getElementById('success-message').textContent = result.message || 'Company created successfully.';
                        document.getElementById('success-message').style.display = 'block';
                    }
                    form.reset();
                } else {
                    if (window.toastr) {
                        toastr.error(result.message || "Failed to create company", "Error");
                    } else {
                        document.getElementById('error-message').textContent = result.message || 'Failed to create company.';
                        document.getElementById('error-message').style.display = 'block';
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                if (window.toastr) {
                    toastr.error("An error occurred while creating company", "Error");
                } else {
                    document.getElementById('error-message').textContent = 'An error occurred while creating company.';
                    document.getElementById('error-message').style.display = 'block';
                }
            }
        });

        // Initialize Select2 for Parent Company
        select2Initializer(
            '#parentCompanySelect',
            '@Url.Action("GetParentCompaniesForSelect2", "UserCompany")',
            'ParentCompany',
            null,
            false,
            false
        );
    </script>
}
