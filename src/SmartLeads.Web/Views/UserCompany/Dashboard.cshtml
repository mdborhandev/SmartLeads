@using SmartLeads.Infrastructure.Services
@using SmartLeads.Infrastructure.Repositories.Interface
@using Microsoft.EntityFrameworkCore
@inject ICompanyContext _companyContext
@inject IUnitOfWork _unitOfWork

@{
    ViewData["Title"] = "Company Dashboard";
    Layout = "_UserCompanyLayout";

    // Get current company
    var currentCompanyId = _companyContext.CurrentCompanyId;
    var currentCompany = currentCompanyId.HasValue
        ? await _unitOfWork.dbContext.Companies.FindAsync(currentCompanyId.Value)
        : null;

    // Get user's companies
    var userCompanies = await _companyContext.GetUserCompaniesAsync();

    // Get employee count if company exists
    int employeeCount = 0;
    int userCount = 0;
    if (currentCompanyId.HasValue)
    {
        employeeCount = await _unitOfWork.dbContext.Employees
            .Where(e => e.CompanyId == currentCompanyId.Value && e.IsActive)
            .CountAsync();
        
        userCount = await _unitOfWork.dbContext.UserCompanies
            .Where(uc => uc.CompanyId == currentCompanyId.Value && uc.IsActive && !uc.IsDeleted)
            .CountAsync();
    }
}

<div class="container-xxl py-4">
    @if (currentCompany != null)
    {
        // If a company is selected, redirect to CompanyInfo
        <script>
            window.location.href = '/UserCompany/CompanyInfo';
        </script>
    }
    else
    {
        // No company selected - show company selection
        <div class="row justify-content-center">
            <div class="col-xxl-8">
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bx bx-buildings display-1 text-primary mb-3"></i>
                        <h3 class="card-title mb-3">Select a Company</h3>
                        <p class="text-muted mb-4">Choose a company from the sidebar or create a new one to get started.</p>
                        
                        @if (userCompanies.Any())
                        {
                            <div class="row g-3 justify-content-center">
                                @foreach (var uc in userCompanies)
                                {
                                    <div class="col-md-4">
                                        <div class="card h-100">
                                            <div class="card-body text-center">
                                                <i class="bx bx-building-house display-4 text-primary mb-3"></i>
                                                <h5 class="card-title">@uc.Company.Name</h5>
                                                <p class="card-text text-muted">@uc.Company.Code</p>
                                                <button class="btn btn-primary" onclick="switchCompanySidebar('@uc.Company.Id', '@uc.Company.Name')">
                                                    <i class="bx bx-select-multiple me-1"></i> Select
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="row g-3 justify-content-center">
                                <div class="col-md-5">
                                    <div class="card h-100">
                                        <div class="card-body text-center">
                                            <i class="bx bx-plus-circle display-4 text-primary mb-3"></i>
                                            <h5 class="card-title">Create Company</h5>
                                            <p class="card-text text-muted">Start a new company</p>
                                            <a asp-action="CreateCompany" class="btn btn-primary">
                                                <i class="bx bx-plus me-1"></i> Create
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                toastr.success('@TempData["SuccessMessage"]', 'Success');
                </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                toastr.error('@TempData["ErrorMessage"]', 'Error');
                </text>
            }
        });
    </script>
}
