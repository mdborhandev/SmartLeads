@using SmartLeads.Infrastructure.Services
@using SmartLeads.Infrastructure.Repositories.Interface
@inject ICompanyContext _companyContext
@inject IUnitOfWork _unitOfWork

@model SmartLeads.Domain.Models.Company

@{
    ViewData["Title"] = "Company Information";
    Layout = "_UserCompanyLayout";

    var userCompanies = await _companyContext.GetUserCompaniesAsync();
    var currentUserCompany = userCompanies.FirstOrDefault(uc => uc.CompanyId == Model.Id);
    var canEdit = currentUserCompany?.Role == SmartLeads.Domain.Enums.UserRole.SuperAdmin;
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bx bx-buildings me-2"></i>Company Information
        </h5>
    </div>
    <div class="card-body">
        <form id="companyForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Company Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Name" id="companyName" value="@Model.Name" @(canEdit ? "" : "readonly") required />
                    <span class="text-danger" id="nameError"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Company Code <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Code" id="companyCode" value="@Model.Code" @(canEdit ? "" : "readonly") required />
                    <span class="text-danger" id="codeError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" name="Email" id="companyEmail" value="@Model.Email" @(canEdit ? "" : "readonly") required />
                    <span class="text-danger" id="emailError"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Phone <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Phone" id="companyPhone" value="@Model.Phone" @(canEdit ? "" : "readonly") required />
                    <span class="text-danger" id="phoneError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Address <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="Address" id="companyAddress" value="@Model.Address" @(canEdit ? "" : "readonly") required />
                    <span class="text-danger" id="addressError"></span>
                </div>
            </div>

            @if (canEdit)
            {
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-outline-primary" id="submitBtn">
                        <i class="bx bx-save me-1"></i> Save
                    </button>
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function clearErrors() {
            $('#nameError').text('');
            $('#codeError').text('');
            $('#emailError').text('');
            $('#phoneError').text('');
            $('#addressError').text('');
        }

        document.getElementById('companyForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearErrors();

            const formData = new FormData(this);
            const url = '@Url.Action("UpdateCompany", "UserCompany")';

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    toastr.success(result.message || "Company information updated successfully", "Success", { "toastClass": "toast-green" });
                } else {
                    if (result.errors) {
                        if (result.errors.Name) $('#nameError').text(result.errors.Name);
                        if (result.errors.Code) $('#codeError').text(result.errors.Code);
                        if (result.errors.Email) $('#emailError').text(result.errors.Email);
                        if (result.errors.Phone) $('#phoneError').text(result.errors.Phone);
                        if (result.errors.Address) $('#addressError').text(result.errors.Address);
                    }
                    toastr.error(result.message || "Failed to update company information", "Error");
                }
            } catch (error) {
                console.error('Error:', error);
                toastr.error("An error occurred while updating company information", "Error");
            }
        });
    </script>
}
