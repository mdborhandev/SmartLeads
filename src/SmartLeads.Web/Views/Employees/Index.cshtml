        // Clear validation errors
        function clearErrors() {
            $('.text-danger').text('');
        }

// Form Submit Handler
        document.getElementById('employeeForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearErrors();

            const form = this;
            const formData = new FormData(form);
            const url = '@Url.Action("Save", "Employees")';

            // Remove Id from formData for create (backend generates Id)
            const idValue = document.getElementById('employeeId').value;
            if (!idValue || idValue === '') {
                formData.delete('Id');
            }

            // Get AntiForgeryToken
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            try {
                console.log('Form data entries:');
                for (let [key, value] of formData.entries()) {
                    console.log(key, value);
                }
                
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });

                console.log('Response status:', response.status);
                
                const result = await response.json();
                console.log('Save response:', result);

                if (result.success) {
                    // Close offcanvas
                    if (employeeOffcanvas) {
                        employeeOffcanvas.hide();
                    }

                    // Show success message
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Employee saved successfully!',
                        timer: 2000
                    });

                    // Reload page
                    setTimeout(() => location.reload(), 2000);
                } else {
                    // Handle errors
                    const errors = result.errors;
                    
                    // Show field errors
                    if (errors && typeof errors === 'object') {
                        for (const [key, value] of Object.entries(errors)) {
                            const errorText = Array.isArray(value) ? value.join(', ') : value;
                            
                            // Find error span - match field names to error element IDs
                            const errorElId = key.replace(/([A-Z])/g, (m) => m.toLowerCase());
                            const errorEl = document.getElementById(errorElId + 'Error');
                            
                            if (errorEl) {
                                errorEl.textContent = errorText;
                            } else {
                                console.log('Error element not found for:', key);
                            }
                        }
                        
                        // Show main error message
                        Swal.fire({
                            icon: 'error',
                            title: 'Validation Error',
                            text: result.message || 'Please check the form for errors.'
                        });
                        
                        // Focus first error field
                        const firstErrorKey = Object.keys(errors).find(k => k !== '__global');
                        if (firstErrorKey) {
                            const inputEl = document.querySelector(`[name="${firstErrorKey}"]`);
                            if (inputEl) {
                                inputEl.focus();
                                inputEl.classList.add('is-invalid');
                            }
                        }
                    } else {
                        // No field errors, show general error
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: result.message || 'An error occurred while saving.'
                        });
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'An error occurred while saving the employee.'
                });
            }
        });

        // Delete Employee
        function deleteEmployee(id, employeeId) {
            Swal.fire({
                title: 'Are you sure?',
                html: `Do you want to delete employee <strong>${employeeId}</strong>?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const formData = new FormData();
                        formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                        const response = await fetch('@Url.Action("Delete", "Employees")/' + id, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: 'Employee has been deleted.',
                                timer: 2000
                            });
                            setTimeout(() => location.reload(), 2000);
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Failed to delete employee.'
                            });
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: 'An error occurred while deleting the employee.'
                        });
                    }
                }
            });
        }
    </script>
