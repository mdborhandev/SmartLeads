@{
    ViewData["Title"] = "Employee List";
}

@Html.AntiForgeryToken()

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">All Employees</h5>
    </div>
    <div class="card-body">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bx bx-check-circle me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-3 align-items-center mb-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bx bx-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search by employee ID, department, designation, or phone..." />
                </div>
            </div>
            <div class="col-md-6">
                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="offcanvas" data-bs-target="#employeeOffcanvas" onclick="openCreateModal()">
                        <i class="bx bx-plus me-1"></i> Add Employee
                    </button>
                    <!-- Export Dropdown -->
                    <div class="dropdown">
                        <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-export me-1"></i> Export
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><button type="button" class="dropdown-item" id="exportCsvBtn">CSV</button></li>
                            <li><button type="button" class="dropdown-item" id="exportExcelBtn">Excel</button></li>
                            <li><button type="button" class="dropdown-item" id="exportPdfBtn">PDF</button></li>
                        </ul>
                    </div>
                    <!-- Column Filter Dropdown -->
                    <div class="dropdown d-inline-block">
                        <button class="btn btn-outline-primary" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bx bx-cog me-1"></i> Columns
                        </button>
                        <div class="dropdown-menu dropdown-menu-end gear-dropdown-employees p-3" style="min-width: 500px;" aria-labelledby="dropdownMenuButton1">
                            <span class="fw-bold">Columns</span>
                            <hr class="my-2" />
                            <ul class="list-unstyled mb-0" id="EmployeesColumnList" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;">
                                <!-- Column checkboxes will be populated here -->
                            </ul>
                            <div class="d-flex">
                                <div class="p-4">
                                    <button id="saveEmployeesFilter" class="btn btn-outline-primary">Save Filter</button>
                                </div>
                                <div class="p-4">
                                    <button id="deleteEmployeesFilter" class="btn btn-outline-danger" onclick="DeleteFilter_Employees('Employees')">Remove Filter</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="employeeTable"></div>
    </div>
</div>

<!-- Employee Offcanvas -->
<div class="offcanvas offcanvas-end w-100" tabindex="-1" id="employeeOffcanvas" aria-labelledby="employeeOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="employeeOffcanvasLabel">Add Employee</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form id="employeeForm" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="employeeId" name="Id" />
            <input type="hidden" id="formAction" value="create" />

            <h6 class="mb-3">Employee Information</h6>
            
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empEmployeeId" class="form-label">Employee ID <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="empEmployeeId" name="EmployeeId" placeholder="e.g., EMP001" required />
                    <span class="text-danger" id="employeeIdError"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empFirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="empFirstName" name="FirstName" required />
                    <span class="text-danger" id="firstNameError"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empLastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="empLastName" name="LastName" required />
                    <span class="text-danger" id="lastNameError"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empMiddleName" class="form-label">Middle Name</label>
                    <input type="text" class="form-control" id="empMiddleName" name="MiddleName" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empNickName" class="form-label">Nick Name</label>
                    <input type="text" class="form-control" id="empNickName" name="NickName" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empWorkEmail" class="form-label">Work Email</label>
                    <input type="email" class="form-control" id="empWorkEmail" name="WorkEmail" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empPersonalEmail" class="form-label">Personal Email</label>
                    <input type="email" class="form-control" id="empPersonalEmail" name="PersonalEmail" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empPhoneNumber" class="form-label">Phone Number</label>
                    <input type="tel" class="form-control" id="empPhoneNumber" name="PhoneNumber" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empAlternatePhoneNumber" class="form-label">Alternate Phone Number</label>
                    <input type="tel" class="form-control" id="empAlternatePhoneNumber" name="AlternatePhoneNumber" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empDepartmentId" class="form-label">Department</label>
                    <select class="form-select" id="empDepartmentId" name="DepartmentId">
                        <option value="">Select Department</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empDesignationId" class="form-label">Designation</label>
                    <select class="form-select" id="empDesignationId" name="DesignationId" disabled>
                        <option value="">Select Designation</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empDateOfJoining" class="form-label">Date of Joining</label>
                    <input type="date" class="form-control" id="empDateOfJoining" name="DateOfJoining" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empDateOfBirth" class="form-label">Date of Birth</label>
                    <input type="date" class="form-control" id="empDateOfBirth" name="DateOfBirth" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empGender" class="form-label">Gender</label>
                    <select class="form-select" id="empGender" name="Gender" data-variable-type="Gender">
                        <option value="">Select Gender</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empMaritalStatus" class="form-label">Marital Status</label>
                    <select class="form-select" id="empMaritalStatus" name="MaritalStatus" data-variable-type="Marital Status">
                        <option value="">Select Marital Status</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empBloodGroup" class="form-label">Blood Group</label>
                    <select class="form-select" id="empBloodGroup" name="BloodGroup" data-variable-type="Blood Group">
                        <option value="">Select Blood Group</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empNationality" class="form-label">Nationality</label>
                    <select class="form-select" id="empNationality" name="Nationality" data-variable-type="Nationality">
                        <option value="">Select Nationality</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empNationalIdNumber" class="form-label">National ID Number</label>
                    <input type="text" class="form-control" id="empNationalIdNumber" name="NationalIdNumber" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empJoiningType" class="form-label">Joining Type</label>
                    <select class="form-select" id="empJoiningType" name="JoiningType" data-variable-type="Joining Type">
                        <option value="">Select Joining Type</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empEmploymentStatus" class="form-label">Employment Status</label>
                    <select class="form-select" id="empEmploymentStatus" name="EmploymentStatus" data-variable-type="Employment Status">
                        <option value="">Select Employment Status</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empProfilePhotoUrl" class="form-label">Profile Photo URL</label>
                    <input type="text" class="form-control" id="empProfilePhotoUrl" name="ProfilePhotoUrl" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empEmergencyContactName" class="form-label">Emergency Contact Name</label>
                    <input type="text" class="form-control" id="empEmergencyContactName" name="EmergencyContactName" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empEmergencyContactPhone" class="form-label">Emergency Contact Phone</label>
                    <input type="text" class="form-control" id="empEmergencyContactPhone" name="EmergencyContactPhone" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empAddress" class="form-label">Address</label>
                    <input type="text" class="form-control" id="empAddress" name="Address" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="empPresentAddress" class="form-label">Present Address</label>
                    <input type="text" class="form-control" id="empPresentAddress" name="PresentAddress" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empPermanentAddress" class="form-label">Permanent Address</label>
                    <input type="text" class="form-control" id="empPermanentAddress" name="PermanentAddress" />
                </div>
                <div class="col-md-4 mb-3">
                    <label for="empNotes" class="form-label">Notes</label>
                    <input type="text" class="form-control" id="empNotes" name="Notes" />
                </div>
            </div>

            <div class="row" id="isActiveRow" style="display: none;">
                <div class="col-12 mb-3">
                    <label for="empIsActive" class="form-label">Status</label>
                    <select class="form-select" id="empIsActive" name="IsActive">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="offcanvas">Cancel</button>
                <button type="submit" class="btn btn-outline-primary" id="submitBtn">Create Employee</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let employeeOffcanvas = null;
        let employeeTable = null;
        let searchTimeout = null;
        let currentSearch = '';

        // Define table columns with visibility settings
        var TableFields = [
            {
                title: "#",
                field: "rownum",
                formatter: "rownum",
                hozAlign: "center",
                headerSort: false,
                width: 50,
                visible: true
            },
            {
                title: "Employee ID",
                field: "employeeId",
                hozAlign: "center",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value ? `<span class="badge bg-info">${value}</span>` : '<span class="badge bg-secondary">N/A</span>';
                }
            },
            {
                title: "First Name",
                field: "firstName",
                hozAlign: "left",
                visible: true
            },
            {
                title: "Last Name",
                field: "lastName",
                hozAlign: "left",
                visible: true
            },
            {
                title: "Middle Name",
                field: "middleName",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Nick Name",
                field: "nickName",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Work Email",
                field: "workEmail",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Personal Email",
                field: "personalEmail",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Department",
                field: "departmentName",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Designation",
                field: "designationName",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Phone",
                field: "phoneNumber",
                hozAlign: "left",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Alt. Phone",
                field: "alternatePhoneNumber",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Emergency Contact",
                field: "emergencyContactName",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Emergency Phone",
                field: "emergencyContactPhone",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "DOB",
                field: "dateOfBirth",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    if (!value) return '-';
                    const date = new Date(value);
                    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                }
            },
            {
                title: "Gender",
                field: "genderText",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Marital",
                field: "maritalStatusText",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Blood Group",
                field: "bloodGroupText",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Nationality",
                field: "nationalityText",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "National ID",
                field: "nationalIdNumber",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Present Address",
                field: "presentAddress",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Permanent Address",
                field: "permanentAddress",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Address",
                field: "address",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "DOJ",
                field: "dateOfJoining",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    if (!value) return '-';
                    const date = new Date(value);
                    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                }
            },
            {
                title: "Joining Type",
                field: "joiningTypeText",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Employment Status",
                field: "employmentStatusText",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value || '-';
                }
            },
            {
                title: "Created",
                field: "createdAt",
                hozAlign: "center",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    if (!value) return '-';
                    const date = new Date(value);
                    return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                }
            },
            {
                title: "Notes",
                field: "notes",
                hozAlign: "left",
                visible: false,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value ? `<span class="text-truncate" style="max-width: 150px;">${value}</span>` : '-';
                }
            },
            {
                title: "Status",
                field: "isActive",
                hozAlign: "center",
                visible: true,
                formatter: function(cell) {
                    const value = cell.getValue();
                    return value
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-secondary">Inactive</span>';
                }
            },
            {
                title: "Actions",
                field: "id",
                hozAlign: "center",
                headerSort: false,
                download: false,
                print: false,
                frozen: true,
                visible: true,
                formatter: function(cell) {
                    const row = cell.getRow().getData();
                    const id = row.id || '';
                    const employeeId = (row.employeeId || '').toString().replace(/'/g, "\\'");
                    const firstName = (row.firstName || '').toString().replace(/'/g, "\\'");
                    const lastName = (row.lastName || '').toString().replace(/'/g, "\\'");
                    const middleName = (row.middleName || '').toString().replace(/'/g, "\\'");
                    const nickName = (row.nickName || '').toString().replace(/'/g, "\\'");
                    const workEmail = (row.workEmail || '').toString().replace(/'/g, "\\'");
                    const personalEmail = (row.personalEmail || '').toString().replace(/'/g, "\\'");
                    const departmentId = (row.departmentId || '').toString().replace(/'/g, "\\'");
                    const designationId = (row.designationId || '').toString().replace(/'/g, "\\'");
                    const departmentName = (row.departmentName || '').toString().replace(/'/g, "\\'");
                    const designationName = (row.designationName || '').toString().replace(/'/g, "\\'");
                    const phoneNumber = (row.phoneNumber || '').toString().replace(/'/g, "\\'");
                    const alternatePhoneNumber = (row.alternatePhoneNumber || '').toString().replace(/'/g, "\\'");
                    const emergencyContactName = (row.emergencyContactName || '').toString().replace(/'/g, "\\'");
                    const emergencyContactPhone = (row.emergencyContactPhone || '').toString().replace(/'/g, "\\'");
                    const dateOfBirth = (row.dateOfBirth || '').toString().replace(/'/g, "\\'");
                    // Variable values (stored ID)
                    const gender = (row.gender || '').toString().replace(/'/g, "\\'");
                    const genderText = (row.genderText || row.gender || '').toString().replace(/'/g, "\\'");
                    const maritalStatus = (row.maritalStatus || '').toString().replace(/'/g, "\\'");
                    const maritalStatusText = (row.maritalStatusText || row.maritalStatus || '').toString().replace(/'/g, "\\'");
                    const bloodGroup = (row.bloodGroup || '').toString().replace(/'/g, "\\'");
                    const bloodGroupText = (row.bloodGroupText || row.bloodGroup || '').toString().replace(/'/g, "\\'");
                    const nationality = (row.nationality || '').toString().replace(/'/g, "\\'");
                    const nationalityText = (row.nationalityText || row.nationality || '').toString().replace(/'/g, "\\'");
                    const nationalIdNumber = (row.nationalIdNumber || '').toString().replace(/'/g, "\\'");
                    const presentAddress = (row.presentAddress || '').toString().replace(/'/g, "\\'");
                    const permanentAddress = (row.permanentAddress || '').toString().replace(/'/g, "\\'");
                    const address = (row.address || '').toString().replace(/'/g, "\\'");
                    const dateOfJoining = (row.dateOfJoining || '').toString().replace(/'/g, "\\'");
                    const joiningType = (row.joiningType || '').toString().replace(/'/g, "\\'");
                    const joiningTypeText = (row.joiningTypeText || row.joiningType || '').toString().replace(/'/g, "\\'");
                    const employmentStatus = (row.employmentStatus || '').toString().replace(/'/g, "\\'");
                    const employmentStatusText = (row.employmentStatusText || row.employmentStatus || '').toString().replace(/'/g, "\\'");
                    const profilePhotoUrl = (row.profilePhotoUrl || '').toString().replace(/'/g, "\\'");
                    const notes = (row.notes || '').toString().replace(/'/g, "\\'");
                    const isActive = row.isActive || false;

                    return `
                        <button class="btn btn-sm btn-outline-primary p-2 me-2"
                            onclick="openEditModalFromTable(
                                '${id}',
                                '${employeeId}',
                                '${firstName}',
                                '${lastName}',
                                '${middleName}',
                                '${nickName}',
                                '${workEmail}',
                                '${personalEmail}',
                                '${departmentId}',
                                '${designationId}',
                                '${departmentName}',
                                '${designationName}',
                                '${phoneNumber}',
                                '${alternatePhoneNumber}',
                                '${emergencyContactName}',
                                '${emergencyContactPhone}',
                                '${dateOfBirth}',
                                '${gender}',
                                '${genderText}',
                                '${maritalStatus}',
                                '${maritalStatusText}',
                                '${bloodGroup}',
                                '${bloodGroupText}',
                                '${nationality}',
                                '${nationalityText}',
                                '${nationalIdNumber}',
                                '${presentAddress}',
                                '${permanentAddress}',
                                '${address}',
                                '${dateOfJoining}',
                                '${joiningType}',
                                '${joiningTypeText}',
                                '${employmentStatus}',
                                '${employmentStatusText}',
                                '${profilePhotoUrl}',
                                '${notes}',
                                ${isActive}
                            )">
                            <i class="bx bx-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger p-2" onclick="deleteEmployee('${id}', '${employeeId}')">
                            <i class="bx bx-trash"></i>
                        </button>
                    `;
                }
            }
        ];

        // Initialize offcanvas and table on page load
        $(document).ready(function() {
            employeeOffcanvas = new bootstrap.Offcanvas(document.getElementById('employeeOffcanvas'));

            // Load column filter settings and initialize table
            EmployeesGear();
        });

        // Load column filter settings and initialize table
        function EmployeesGear() {
            $.ajax({
                url: '@Url.Action("GetFilteredColumn", "ColumnFilter")',
                type: 'GET',
                data: { type: 'Employees' },
                success: function (response) {
                    console.log("GetFilteredColumn response:", response);

                    if ((response.Success == 1 || response.success == 1) && response.data && response.data.keyValue) {
                        try {
                            const savedData = JSON.parse(response.data.keyValue);
                            console.log("Parsed saved data:", savedData);

                            if (savedData.colDefs && Array.isArray(savedData.colDefs)) {
                                // Reorder TableFields based on saved order
                                const newTableFields = [];

                                // First add columns in saved order
                                savedData.colDefs.forEach(savedCol => {
                                    const tableCol = TableFields.find(col => col.field === savedCol.field);
                                    if (tableCol) {
                                        tableCol.visible = savedCol.visible !== undefined ? savedCol.visible : true;
                                        newTableFields.push(tableCol);
                                    }
                                });

                                // Then add any new columns that weren't in saved config (like Actions)
                                TableFields.forEach(col => {
                                    if (!newTableFields.find(c => c.field === col.field)) {
                                        newTableFields.push(col);
                                    }
                                });

                                // Replace TableFields with reordered array
                                TableFields.length = 0;
                                TableFields.push(...newTableFields);

                                console.log("Updated TableFields:", TableFields);
                            }
                        } catch (e) {
                            console.error("Error parsing saved columns:", e);
                        }
                    }
                    populateCheckbox();
                    initializeEmployeeTable();
                    setupSearchFilter();
                    setupExportButtons();
                    setupColumnFilterSave();
                },
                error: function (error) {
                    console.error("Error fetching column settings:", error);
                    populateCheckbox();
                    initializeEmployeeTable();
                    setupSearchFilter();
                    setupExportButtons();
                    setupColumnFilterSave();
                }
            });
        }

        // Populate column filter checkboxes
        function populateCheckbox() {
            let columns = TableFields
                .filter(x => x.field !== 'id' && x.field !== 'rownum'); // Exclude actions and # columns
            
            let items = columns.map(x => {
                return `
                    <li class="d-flex justify-content-between align-items-center px-2 py-1 draggable-item" data-field="${x.field}" style="background: var(--bs-body-bg); border-radius: 4px;">
                        <span class="d-flex align-items-center small">
                            <i class="bx bx-menu me-1 handle" style="cursor: move;"></i> ${x.title}
                        </span>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input toggle-column employees-column" type="checkbox" role="switch"
                                   id="${x.field}" value="${x.field}" ${x.visible ? 'checked' : ''}
                                   onclick="showHideColumn('${x.field}')">
                        </div>
                    </li>`;
            });

            const columnList = document.getElementById('EmployeesColumnList');
            columnList.innerHTML = items.join('');
            enableDragAndDrop();
        }

        // Enable drag and drop for column ordering
        function enableDragAndDrop() {
            new Sortable(document.getElementById('EmployeesColumnList'), {
                animation: 200,
                handle: '.handle',
                ghostClass: 'sortable-ghost',
                chosenClass: 'sortable-chosen',
                dragClass: 'sortable-drag',
                forceFallback: true,
                fallbackTolerance: 5,
                scroll: true,
                scrollSensitivity: 30,
                scrollSpeed: 10,
                onEnd: function (evt) {
                    updateColumnOrder();
                }
            });
        }

        // Update column order based on drag and drop
        function updateColumnOrder() {
            let newOrder = [];
            document.querySelectorAll('#EmployeesColumnList .draggable-item').forEach(item => {
                const field = item.getAttribute('data-field');
                const title = item.querySelector('span').innerText.trim();
                const visible = item.querySelector('input').checked;
                newOrder.push({ field: field, title: title, visible: visible });
            });

            let allColumns = employeeTable.getColumns().map(col => col.getDefinition());
            let fixedColumns = allColumns.filter(col => col.field === 'id');
            let newColumns = newOrder.map(col => {
                let existingColumn = employeeTable.getColumn(col.field);
                return existingColumn ? existingColumn.getDefinition() : { title: col.title, field: col.field, visible: col.visible };
            });

            newColumns = [...newColumns, ...fixedColumns];
            employeeTable.setColumns(newColumns);

            // Update TableFields array to match new order (for saving)
            const actionColumn = TableFields.find(col => col.field === 'id');
            TableFields = newColumns;
            if (actionColumn && !TableFields.find(col => col.field === 'id')) {
                TableFields.push(actionColumn);
            }

            // Re-populate checkboxes
            populateCheckbox();
        }

