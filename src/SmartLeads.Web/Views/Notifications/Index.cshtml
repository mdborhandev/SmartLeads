@model SmartLeads.Domain.DTOs.NotificationListResponse
@{
    ViewData["Title"] = "Notifications";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title">
                            <i class="fas fa-bell"></i> Notifications
                            @if (ViewBag.UnreadCount > 0)
                            {
                                <span class="badge badge-danger">@ViewBag.UnreadCount unread</span>
                            }
                        </h3>
                        <div>
                            @if (ViewBag.UnreadCount > 0)
                            {
                                <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="fas fa-check-double"></i> Mark All as Read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Filters -->
                    <form method="get" asp-action="Index" class="mb-4">
                        <div class="row">
                            <div class="col-md-3">
                                <select name="type" class="form-control">
                                    <option value="">All Types</option>
                                    <option value="Task" selected="@(ViewBag.SelectedType == "Task")">Task</option>
                                    <option value="Email" selected="@(ViewBag.SelectedType == "Email")">Email</option>
                                    <option value="System" selected="@(ViewBag.SelectedType == "System")">System</option>
                                    <option value="Alert" selected="@(ViewBag.SelectedType == "Alert")">Alert</option>
                                    <option value="Invitation" selected="@(ViewBag.SelectedType == "Invitation")">Invitation</option>
                                    <option value="Contact" selected="@(ViewBag.SelectedType == "Contact")">Contact</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <select name="status" class="form-control">
                                    <option value="">All Statuses</option>
                                    <option value="Unread" selected="@(ViewBag.SelectedStatus == "Unread")">Unread</option>
                                    <option value="Read" selected="@(ViewBag.SelectedStatus == "Read")">Read</option>
                                    <option value="Archived" selected="@(ViewBag.SelectedStatus == "Archived")">Archived</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="fas fa-filter"></i> Filter
                                </button>
                            </div>
                        </div>
                    </form>

                    @if (!Model.Notifications.Any())
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-bell-slash fa-4x text-muted mb-3"></i>
                            <h5 class="text-muted">No notifications</h5>
                            <p class="text-muted">You're all caught up!</p>
                        </div>
                    }
                    else
                    {
                        <!-- Notifications List -->
                        <div class="list-group">
                            @foreach (var notification in Model.Notifications)
                            {
                                <div class="list-group-item list-group-item-action @(notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread ? "border-left border-primary border-left-4" : "")">
                                    <div class="d-flex w-100 justify-content-between">
                                        <div class="d-flex align-items-center">
                                            @if (notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread)
                                            {
                                                <span class="badge badge-primary mr-2">New</span>
                                            }
                                            <h5 class="mb-1">@notification.Title</h5>
                                        </div>
                                        <small>@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-1">@notification.Message</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge badge-info">@notification.Type</span>
                                            <span class="badge badge-@(notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread ? "warning" : notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Read ? "success" : "secondary")">
                                                @notification.Status
                                            </span>
                                        </div>
                                        <div>
                                            @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                            {
                                                <a href="@notification.ActionUrl" class="btn btn-sm btn-primary mr-1">
                                                    <i class="fas fa-arrow-right"></i> View
                                                </a>
                                            }
                                            <form asp-action="Details" method="get" class="d-inline">
                                                <input type="hidden" name="id" value="@notification.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary mr-1">
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                            </form>
                                            @if (notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread)
                                            {
                                                <form asp-action="MarkAsRead" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@notification.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success mr-1">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form asp-action="Archive" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@notification.Id" />
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Archive this notification?')">
                                                    <i class="fas fa-archive"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        @if (ViewBag.TotalCount > 20)
                        {
                            <nav aria-label="Notifications pagination" class="mt-4">
                                <ul class="pagination justify-content-center">
                                    @{
                                        var totalPages = (int)Math.Ceiling((double)ViewBag.TotalCount / 20);
                                        var currentPage = ViewBag.CurrentPage;
                                        
                                        if (currentPage > 1)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, type = ViewBag.SelectedType, status = ViewBag.SelectedStatus })">Previous</a>
                                            </li>
                                        }
                                        
                                        for (int i = 1; i <= totalPages; i++)
                                        {
                                            if (i == currentPage)
                                            {
                                                <li class="page-item active"><span class="page-link">@i</span></li>
                                            }
                                            else if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" href="@Url.Action("Index", new { page = i, type = ViewBag.SelectedType, status = ViewBag.SelectedStatus })">@i</a>
                                                </li>
                                            }
                                            else if (i == currentPage - 3 || i == currentPage + 3)
                                            {
                                                <li class="page-item disabled"><span class="page-link">...</span></li>
                                            }
                                        }
                                        
                                        if (currentPage < totalPages)
                                        {
                                            <li class="page-item">
                                                <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, type = ViewBag.SelectedType, status = ViewBag.SelectedStatus })">Next</a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
