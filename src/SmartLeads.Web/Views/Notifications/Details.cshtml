@model SmartLeads.Domain.DTOs.NotificationDto
@{
    ViewData["Title"] = "Notification Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title">
                            <i class="fas fa-bell"></i> Notification Details
                        </h3>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <h2>@Model.Title</h2>
                            <p class="text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
                            <hr />
                            <p style="font-size: 1.1em; line-height: 1.6;">@Model.Message</p>
                            
                            @if (!string.IsNullOrEmpty(Model.ActionUrl))
                            {
                                <div class="mt-4">
                                    <a href="@Model.ActionUrl" class="btn btn-primary">
                                        <i class="fas fa-arrow-right"></i> Go to Related Item
                                    </a>
                                </div>
                            }
                        </div>
                        <div class="col-md-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5 class="card-title mb-0">Details</h5>
                                </div>
                                <div class="card-body">
                                    <dl class="row">
                                        <dt class="col-sm-5">Type</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge badge-info">@Model.Type</span>
                                        </dd>
                                        
                                        <dt class="col-sm-5">Status</dt>
                                        <dd class="col-sm-7">
                                            <span class="badge badge-@(Model.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread ? "warning" : Model.Status == SmartLeads.Domain.Enums.NotificationStatus.Read ? "success" : "secondary")">
                                                @Model.Status
                                            </span>
                                        </dd>
                                        
                                        <dt class="col-sm-5">Created</dt>
                                        <dd class="col-sm-7">@Model.CreatedAt.ToString("MMM dd, yyyy")</dd>
                                        
                                        @if (Model.IsEmailSent)
                                        {
                                            <dt class="col-sm-5">Email Sent</dt>
                                            <dd class="col-sm-7">
                                                <span class="badge badge-success">Yes</span>
                                            </dd>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(Model.RelatedEntityType))
                                        {
                                            <dt class="col-sm-5">Related Type</dt>
                                            <dd class="col-sm-7">@Model.RelatedEntityType</dd>
                                        }
                                        
                                        @if (Model.RelatedEntityId.HasValue)
                                        {
                                            <dt class="col-sm-5">Related ID</dt>
                                            <dd class="col-sm-7"><code>@Model.RelatedEntityId.Value</code></dd>
                                        }
                                    </dl>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
