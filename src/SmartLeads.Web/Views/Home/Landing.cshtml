<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

<!-- Hero Section -->
<div class="bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-white text-primary rounded d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-bullseye fa-lg"></i>
                    </div>
                    <h1 class="h2 fw-bold mb-0">Smart<span class="bg-white text-primary px-2 rounded">Leads</span></h1>
                </div>
                <h2 class="display-5 fw-bold mb-4">
                    Manage Your Contacts & Convert More Leads
                </h2>
                <p class="lead mb-4 opacity-75">
                    The all-in-one contact and lead management platform that helps you organize, 
                    track, and nurture your business relationships.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-action="Register" asp-controller="Auth" class="btn btn-light btn-lg px-4">
                        <i class="fas fa-rocket me-2"></i>Get Started Free
                    </a>
                    <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-light btn-lg px-4">
                        <i class="fas fa-sign-in-alt me-2"></i>Sign In
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <i class="fas fa-bullseye fa-10x opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="h3 fw-bold mb-3">Why Choose SmartLeads?</h2>
        <p class="text-muted">Powerful features to help you manage contacts and grow your business</p>
    </div>

    <div class="row g-4">
        <!-- Feature 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-address-book fa-lg"></i>
                    </div>
                    <h5 class="card-title">Contact Management</h5>
                    <p class="card-text text-muted">
                        Organize all your contacts in one place. Add, edit, and manage contact details with ease.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-filter fa-lg"></i>
                    </div>
                    <h5 class="card-title">Groups & Tags</h5>
                    <p class="card-text text-muted">
                        Categorize contacts with custom groups and tags. Create segments for targeted communication.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-search fa-lg"></i>
                    </div>
                    <h5 class="card-title">Advanced Search</h5>
                    <p class="card-text text-muted">
                        Find contacts instantly with powerful search and filtering. Locate information in seconds.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 4 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-building fa-lg"></i>
                    </div>
                    <h5 class="card-title">Multi-Company</h5>
                    <p class="card-text text-muted">
                        Manage multiple companies from a single account. Switch between companies seamlessly.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 5 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-chart-line fa-lg"></i>
                    </div>
                    <h5 class="card-title">Lead Tracking</h5>
                    <p class="card-text text-muted">
                        Track leads through your sales pipeline. Monitor progress and close more deals.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 6 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="fas fa-shield-alt fa-lg"></i>
                    </div>
                    <h5 class="card-title">Secure & Private</h5>
                    <p class="card-text text-muted">
                        Your data security is our priority. Industry-standard encryption keeps your information safe.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<div class="bg-light py-5 mb-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h3 fw-bold mb-3">Get Started in 3 Simple Steps</h2>
            <p class="text-muted">Start managing your contacts and leads in minutes</p>
        </div>

        <div class="row g-4">
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fw-bold" style="width: 60px; height: 60px; font-size: 24px;">
                        1
                    </div>
                    <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                        <i class="fas fa-user-plus fa-2x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Create Account</h5>
                    <p class="text-muted">
                        Sign up for free in less than 2 minutes. No credit card required.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fw-bold" style="width: 60px; height: 60px; font-size: 24px;">
                        2
                    </div>
                    <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                        <i class="fas fa-building fa-2x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Join or Create Company</h5>
                    <p class="text-muted">
                        Join your company with an invite code or create your own company.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="text-center">
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fw-bold" style="width: 60px; height: 60px; font-size: 24px;">
                        3
                    </div>
                    <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3 shadow-sm" style="width: 80px; height: 80px;">
                        <i class="fas fa-rocket fa-2x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Start Managing</h5>
                    <p class="text-muted">
                        Add contacts, organize them into groups, and start tracking leads.
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-5">
            <a asp-action="Register" asp-controller="Auth" class="btn btn-primary btn-lg px-5">
                <i class="fas fa-bolt me-2"></i>Start Now - It's Free!
            </a>
        </div>
    </div>
</div>

<!-- CTA Section -->
<div class="bg-primary text-white py-5">
    <div class="container text-center">
        <h2 class="h3 fw-bold mb-3">Ready to Transform Your Contact Management?</h2>
        <p class="lead mb-4 opacity-75">
            Join thousands of businesses already using SmartLeads.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-action="Register" asp-controller="Auth" class="btn btn-light btn-lg px-5">
                <i class="fas fa-user-plus me-2"></i>Create Free Account
            </a>
            <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-light btn-lg px-4">
                <i class="fas fa-sign-in-alt me-2"></i>Already have account?
            </a>
        </div>
    </div>
</div>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-4">
    <div class="container">
        <p class="mb-0">&copy; @DateTime.Now.Year SmartLeads. All rights reserved.</p>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
