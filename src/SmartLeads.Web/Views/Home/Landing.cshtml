@{
    ViewData["Title"] = "SmartLeads";
    Layout = "_AuthLayout";
}

<div class="container-fluid py-4 py-lg-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-xxl-10">
                <section class="card border-0 shadow-sm overflow-hidden mb-4 mb-lg-5">
                    <div class="card-body p-4 p-md-5">
                        <div class="row align-items-center g-4 g-lg-5">
                            <div class="col-lg-7">
                                <span class="badge bg-primary-subtle text-primary-emphasis rounded-pill px-3 py-2 mb-3">
                                    Lead management for growing teams
                                </span>
                                <h1 class="display-4 fw-bold text-dark mb-3">
                                    Organize contacts, track leads, and keep every follow-up moving.
                                </h1>
                                <p class="fs-5 text-muted mb-4">
                                    SmartLeads gives your team one place to manage contacts, segment audiences, and turn pipeline activity into measurable growth.
                                </p>
                                <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                                    <a asp-action="Register" asp-controller="Auth" class="btn btn-primary btn-lg px-4">
                                        Create free account
                                    </a>
                                    <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-primary btn-lg px-4">
                                        Sign in
                                    </a>
                                </div>
                                <div class="row row-cols-1 row-cols-sm-3 g-3">
                                    <div class="col">
                                        <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                                            <div class="small text-muted text-uppercase fw-semibold mb-1">Contacts</div>
                                            <div class="h4 mb-0 fw-bold">Centralized</div>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                                            <div class="small text-muted text-uppercase fw-semibold mb-1">Pipeline</div>
                                            <div class="h4 mb-0 fw-bold">Visible</div>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="border rounded-3 p-3 h-100 bg-body-tertiary">
                                            <div class="small text-muted text-uppercase fw-semibold mb-1">Teams</div>
                                            <div class="h4 mb-0 fw-bold">Aligned</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="card border-primary border-2 shadow-sm">
                                    <div class="card-header bg-primary text-white py-3">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-semibold">Sales snapshot</span>
                                            <span class="badge bg-light text-primary">Live workflow</span>
                                        </div>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="d-flex justify-content-between align-items-center border rounded-3 p-3 mb-3">
                                            <div>
                                                <div class="fw-semibold">New leads</div>
                                                <div class="text-muted small">Collected this week</div>
                                            </div>
                                            <span class="badge bg-primary rounded-pill fs-6">128</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center border rounded-3 p-3 mb-3">
                                            <div>
                                                <div class="fw-semibold">Qualified</div>
                                                <div class="text-muted small">Ready for follow-up</div>
                                            </div>
                                            <span class="badge bg-success rounded-pill fs-6">42</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center border rounded-3 p-3 mb-4">
                                            <div>
                                                <div class="fw-semibold">Pending tasks</div>
                                                <div class="text-muted small">Scheduled reminders</div>
                                            </div>
                                            <span class="badge bg-warning text-dark rounded-pill fs-6">16</span>
                                        </div>
                                        <div class="alert alert-light border mb-0">
                                            <div class="fw-semibold mb-1">One workspace for your process</div>
                                            <div class="text-muted small mb-0">Move from lead capture to conversion without juggling spreadsheets or disconnected tools.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="mb-4 mb-lg-5">
                    <div class="row g-4">
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body p-4">
                                    <span class="badge bg-primary-subtle text-primary-emphasis mb-3">01</span>
                                    <h3 class="h5 fw-bold">Contact management</h3>
                                    <p class="text-muted mb-0">Store people, companies, notes, and communication history in one searchable view.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body p-4">
                                    <span class="badge bg-success-subtle text-success-emphasis mb-3">02</span>
                                    <h3 class="h5 fw-bold">Groups and tagging</h3>
                                    <p class="text-muted mb-0">Segment records by campaign, team, source, or any workflow that matters to your business.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body p-4">
                                    <span class="badge bg-info-subtle text-info-emphasis mb-3">03</span>
                                    <h3 class="h5 fw-bold">Lead tracking</h3>
                                    <p class="text-muted mb-0">Monitor status changes and keep sales activity focused on the next high-value step.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body p-4">
                                    <span class="badge bg-warning-subtle text-warning-emphasis mb-3">04</span>
                                    <h3 class="h5 fw-bold">Multi-company support</h3>
                                    <p class="text-muted mb-0">Switch between organizations and keep each workspace structured and isolated.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card border-0 bg-body-tertiary shadow-sm mb-4 mb-lg-5">
                    <div class="card-body p-4 p-md-5">
                        <div class="row g-4 align-items-center">
                            <div class="col-lg-5">
                                <span class="badge bg-dark rounded-pill px-3 py-2 mb-3">How it works</span>
                                <h2 class="display-6 fw-bold mb-3">Start with a simple setup, then scale the workflow.</h2>
                                <p class="text-muted mb-0">The onboarding flow is built for teams that need to move quickly without sacrificing structure.</p>
                            </div>
                            <div class="col-lg-7">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm">
                                            <div class="card-body p-4">
                                                <div class="badge bg-primary rounded-pill mb-3">Step 1</div>
                                                <h3 class="h5 fw-bold">Create your account</h3>
                                                <p class="text-muted mb-0">Register in minutes and access your workspace immediately.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm">
                                            <div class="card-body p-4">
                                                <div class="badge bg-primary rounded-pill mb-3">Step 2</div>
                                                <h3 class="h5 fw-bold">Join or create a company</h3>
                                                <p class="text-muted mb-0">Connect your team under a single company environment.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm">
                                            <div class="card-body p-4">
                                                <div class="badge bg-primary rounded-pill mb-3">Step 3</div>
                                                <h3 class="h5 fw-bold">Track leads daily</h3>
                                                <p class="text-muted mb-0">Add contacts, update stages, and keep follow-ups accountable.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="card border-0 bg-primary text-white shadow-sm">
                    <div class="card-body p-4 p-md-5 text-center">
                        <h2 class="display-6 fw-bold mb-3">Build a cleaner lead workflow from day one.</h2>
                        <p class="fs-5 text-white-50 mb-4">Use SmartLeads to replace scattered tracking with a focused, team-ready system.</p>
                        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                            <a asp-action="Register" asp-controller="Auth" class="btn btn-light btn-lg px-4">
                                Get started free
                            </a>
                            <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-light btn-lg px-4">
                                I already have an account
                            </a>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>
</div>
