@{
    ViewData["Title"] = "SmartLeads";
    ViewData["BodyClass"] = "landing-page-body";
    Layout = "_AuthLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/landing-page.css" />
}

<div class="landing-page-shell">
    <div class="landing-page-glow landing-page-glow-one"></div>
    <div class="landing-page-glow landing-page-glow-two"></div>

    <div class="container py-4 py-lg-5">
        <div class="landing-topbar reveal-on-scroll">
            <a href="#overview" class="landing-brand text-decoration-none">
                <span class="landing-brand-mark">SL</span>
                <span>
                    <span class="d-block fw-semibold text-dark">SmartLeads</span>
                    <span class="small text-muted">Contact and pipeline workspace</span>
                </span>
            </a>

            <div class="landing-topbar-actions">
                <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-secondary rounded-pill px-4">Sign in</a>
                <a asp-action="Register" asp-controller="Auth" class="btn btn-primary rounded-pill px-4">Start free</a>
            </div>
        </div>

        <nav class="landing-section-tabs reveal-on-scroll" aria-label="Landing page sections">
            <a href="#overview" class="landing-tab-link is-active" data-tab-link>Overview</a>
            <a href="#features" class="landing-tab-link" data-tab-link>Features</a>
            <a href="#pricing" class="landing-tab-link" data-tab-link>Pricing</a>
            <a href="#workflow" class="landing-tab-link" data-tab-link>Workflow</a>
            <a href="#faq" class="landing-tab-link" data-tab-link>FAQ</a>
        </nav>

        <section id="overview" class="landing-panel landing-hero-panel reveal-on-scroll">
            <div class="row align-items-center g-4 g-xl-5">
                <div class="col-lg-7">
                    <span class="landing-kicker">One place for leads, companies, follow-ups, and action</span>
                    <h1 class="landing-hero-title">
                        A sharper landing page with movement, hover depth, and one-page navigation built in.
                    </h1>
                    <p class="landing-hero-copy">
                        SmartLeads gives your team a focused CRM surface with faster contact handling, cleaner pipeline visibility, and a landing experience that feels active instead of static.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                        <a asp-action="Register" asp-controller="Auth" class="btn btn-primary btn-lg rounded-pill px-4">Create free account</a>
                        <a href="#pricing" class="btn btn-outline-dark btn-lg rounded-pill px-4">See pricing</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="landing-stat-card interactive-lift" data-tilt-card>
                                <div class="landing-stat-value" data-counter="320">0</div>
                                <div class="landing-stat-label">Qualified contacts managed weekly</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="landing-stat-card interactive-lift" data-tilt-card>
                                <div class="landing-stat-value" data-counter="74">0</div>
                                <div class="landing-stat-label">Percent faster follow-up tracking</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="landing-stat-card interactive-lift" data-tilt-card>
                                <div class="landing-stat-value" data-counter="12">0</div>
                                <div class="landing-stat-label">Teams supported inside one workspace</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="landing-dashboard-card floating-card">
                        <div class="landing-dashboard-head">
                            <div>
                                <div class="small text-uppercase text-muted fw-semibold">Live overview</div>
                                <h2 class="h4 fw-bold mb-0">Pipeline health board</h2>
                            </div>
                            <span class="badge text-bg-success rounded-pill">Auto-updating</span>
                        </div>

                        <div class="landing-dashboard-grid">
                            <div class="dashboard-mini-card interactive-lift" data-tilt-card>
                                <span class="dashboard-mini-label">New leads</span>
                                <strong>128</strong>
                                <small>Today</small>
                            </div>
                            <div class="dashboard-mini-card interactive-lift" data-tilt-card>
                                <span class="dashboard-mini-label">Qualified</span>
                                <strong>42</strong>
                                <small>This week</small>
                            </div>
                        </div>

                        <div class="landing-progress-card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-semibold">Conversion momentum</span>
                                <span class="text-primary fw-bold">74%</span>
                            </div>
                            <div class="progress landing-progress-bar" role="progressbar" aria-label="Conversion momentum" aria-valuenow="74" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" data-progress-width="74%"></div>
                            </div>
                        </div>

                        <div class="landing-activity-list">
                            <div class="landing-activity-item interactive-lift" data-tilt-card>
                                <span class="landing-activity-dot"></span>
                                <div>
                                    <strong>Capture and enrich</strong>
                                    <p class="mb-0 text-muted">Store context, owners, notes, and company data together.</p>
                                </div>
                            </div>
                            <div class="landing-activity-item interactive-lift" data-tilt-card>
                                <span class="landing-activity-dot"></span>
                                <div>
                                    <strong>Assign and follow</strong>
                                    <p class="mb-0 text-muted">Keep next actions visible without leaving the workspace.</p>
                                </div>
                            </div>
                            <div class="landing-activity-item interactive-lift" data-tilt-card>
                                <span class="landing-activity-dot"></span>
                                <div>
                                    <strong>Convert with clarity</strong>
                                    <p class="mb-0 text-muted">See movement by stage and recover stalled deals earlier.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="features" class="landing-panel reveal-on-scroll">
            <div class="landing-section-heading">
                <span class="landing-kicker">Features</span>
                <h2 class="display-6 fw-bold mb-3">Every section stays on the same page, but each part still gets its own focus.</h2>
                <p class="text-muted mb-0">The tab menu jumps users to pricing and related content instantly, while motion keeps the page from feeling flat.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-xl-3">
                    <article class="landing-feature-card interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="feature-badge text-bg-primary">Contacts</span>
                        <h3 class="h4 fw-bold mt-3">Clean lead records</h3>
                        <p class="text-muted mb-0">Centralize companies, contact people, notes, and lead source in one searchable place.</p>
                    </article>
                </div>
                <div class="col-md-6 col-xl-3">
                    <article class="landing-feature-card interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="feature-badge text-bg-success">Pipeline</span>
                        <h3 class="h4 fw-bold mt-3">Status visibility</h3>
                        <p class="text-muted mb-0">Track progress across stages and keep the next step visible for every opportunity.</p>
                    </article>
                </div>
                <div class="col-md-6 col-xl-3">
                    <article class="landing-feature-card interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="feature-badge text-bg-warning">Teams</span>
                        <h3 class="h4 fw-bold mt-3">Multi-company ready</h3>
                        <p class="text-muted mb-0">Support teams, agencies, or separate workspaces without turning the UI into clutter.</p>
                    </article>
                </div>
                <div class="col-md-6 col-xl-3">
                    <article class="landing-feature-card interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="feature-badge text-bg-info">Workflow</span>
                        <h3 class="h4 fw-bold mt-3">Fast onboarding</h3>
                        <p class="text-muted mb-0">New users can register, set up a company, and start tracking leads in one short path.</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="pricing" class="landing-panel reveal-on-scroll">
            <div class="landing-section-heading">
                <span class="landing-kicker">Pricing</span>
                <h2 class="display-6 fw-bold mb-3">Simple one-page pricing cards with strong hover states.</h2>
                <p class="text-muted mb-0">You asked for pricing inside the same page, so it sits here as a section instead of a separate route.</p>
            </div>

            <div class="row g-4 align-items-stretch">
                <div class="col-lg-4">
                    <article class="pricing-card interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="pricing-plan">Starter</span>
                        <div class="pricing-amount">$0</div>
                        <p class="text-muted">For single users testing the workflow.</p>
                        <ul class="pricing-list">
                            <li>Contact management</li>
                            <li>Basic pipeline stages</li>
                            <li>One workspace</li>
                        </ul>
                        <a asp-action="Register" asp-controller="Auth" class="btn btn-outline-dark rounded-pill w-100">Start now</a>
                    </article>
                </div>

                <div class="col-lg-4">
                    <article class="pricing-card pricing-card-featured interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="pricing-plan">Growth</span>
                        <div class="pricing-amount">$29<span>/mo</span></div>
                        <p class="text-muted">For growing teams that need shared execution.</p>
                        <ul class="pricing-list">
                            <li>Unlimited contacts</li>
                            <li>Team visibility</li>
                            <li>Workspace collaboration</li>
                        </ul>
                        <a asp-action="Register" asp-controller="Auth" class="btn btn-primary rounded-pill w-100">Choose growth</a>
                    </article>
                </div>

                <div class="col-lg-4">
                    <article class="pricing-card interactive-lift reveal-on-scroll" data-tilt-card>
                        <span class="pricing-plan">Scale</span>
                        <div class="pricing-amount">$79<span>/mo</span></div>
                        <p class="text-muted">For agencies or multi-company operations.</p>
                        <ul class="pricing-list">
                            <li>Advanced team access</li>
                            <li>Multi-company support</li>
                            <li>Priority onboarding</li>
                        </ul>
                        <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-dark rounded-pill w-100">Talk to team</a>
                    </article>
                </div>
            </div>
        </section>

        <section id="workflow" class="landing-panel reveal-on-scroll">
            <div class="row g-4 align-items-center">
                <div class="col-lg-5">
                    <span class="landing-kicker">Workflow</span>
                    <h2 class="display-6 fw-bold mb-3">Three-step onboarding now sits beside a visual timeline.</h2>
                    <p class="text-muted mb-4">This section uses staggered reveal animation so each step comes in with a short delay as users scroll.</p>
                    <a asp-action="Register" asp-controller="Auth" class="btn btn-dark rounded-pill px-4">Open your workspace</a>
                </div>

                <div class="col-lg-7">
                    <div class="workflow-timeline">
                        <article class="workflow-step reveal-on-scroll interactive-lift" data-tilt-card>
                            <span class="workflow-number">01</span>
                            <div>
                                <h3 class="h5 fw-bold">Register</h3>
                                <p class="mb-0 text-muted">Create an account and enter the workspace without a long setup flow.</p>
                            </div>
                        </article>
                        <article class="workflow-step reveal-on-scroll interactive-lift" data-tilt-card>
                            <span class="workflow-number">02</span>
                            <div>
                                <h3 class="h5 fw-bold">Create company</h3>
                                <p class="mb-0 text-muted">Set up the company container so your team, contacts, and pipeline stay connected.</p>
                            </div>
                        </article>
                        <article class="workflow-step reveal-on-scroll interactive-lift" data-tilt-card>
                            <span class="workflow-number">03</span>
                            <div>
                                <h3 class="h5 fw-bold">Track and convert</h3>
                                <p class="mb-0 text-muted">Add leads, assign owners, and move opportunities forward with better visibility.</p>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <section id="faq" class="landing-panel reveal-on-scroll">
            <div class="landing-section-heading">
                <span class="landing-kicker">FAQ</span>
                <h2 class="display-6 fw-bold mb-3">Related information stays in this same page too.</h2>
                <p class="text-muted mb-0">Instead of sending users away, the page now includes common questions directly in the flow.</p>
            </div>

            <div class="accordion landing-faq" id="landingFaq">
                <div class="accordion-item reveal-on-scroll">
                    <h3 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqOne" aria-expanded="true" aria-controls="faqOne">
                            Is pricing on the same page?
                        </button>
                    </h3>
                    <div id="faqOne" class="accordion-collapse collapse show" data-bs-parent="#landingFaq">
                        <div class="accordion-body text-muted">
                            Yes. The section tabs scroll users to pricing, features, workflow, and FAQ without opening separate pages.
                        </div>
                    </div>
                </div>
                <div class="accordion-item reveal-on-scroll">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqTwo" aria-expanded="false" aria-controls="faqTwo">
                            What animations were added?
                        </button>
                    </h3>
                    <div id="faqTwo" class="accordion-collapse collapse" data-bs-parent="#landingFaq">
                        <div class="accordion-body text-muted">
                            The page now includes floating hero motion, scroll reveal, active section tabs, animated counters, progress fill, and hover tilt on cards.
                        </div>
                    </div>
                </div>
                <div class="accordion-item reveal-on-scroll">
                    <h3 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqThree" aria-expanded="false" aria-controls="faqThree">
                            Is the script isolated to this landing page?
                        </button>
                    </h3>
                    <div id="faqThree" class="accordion-collapse collapse" data-bs-parent="#landingFaq">
                        <div class="accordion-body text-muted">
                            Yes. The JavaScript and stylesheet are added through page sections so they only load on this view.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="landing-cta-panel reveal-on-scroll">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <span class="landing-kicker">Ready to start</span>
                    <h2 class="display-5 fw-bold mb-3">Turn the landing page into something more alive and easier to explore.</h2>
                    <p class="fs-5 text-muted mb-0">Users can now jump between sections, see motion while scrolling, and stay in one page from hero to pricing.</p>
                </div>
                <div class="col-lg-4">
                    <div class="d-grid gap-3">
                        <a asp-action="Register" asp-controller="Auth" class="btn btn-primary btn-lg rounded-pill">Create free account</a>
                        <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-secondary btn-lg rounded-pill">Already have an account</a>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/landing-page.js"></script>
}
