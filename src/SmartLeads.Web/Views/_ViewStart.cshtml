@{
    // Redirect unauthenticated users to login page (except for public pages)
    var controller = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower();
    var action = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower();

    if (!User.Identity?.IsAuthenticated ?? true)
    {
        // Allow access to Auth controller and public Home pages
        if (controller == "auth")
        {
            // Auth controller is always accessible (Login, Register, etc.)
            return;
        }

        if (controller == "home" && (action == "landing" || action == "privacy" || action == "components"))
        {
            // Public Home pages
            return;
        }

        // Allow access to UserCompany controller for creating/joining company
        if (controller == "usercompany")
        {
            return;
        }

        // All other pages require authentication
        Context.Response.Redirect("/Auth/Login");
        return;
    }

    // Determine which layout to use based on session preference
    // UseUserCompanyLayout = true → _UserCompanyLayout
    // UseUserCompanyLayout = false or not set → _Layout (Main)
    var useUserCompanyLayout = Context.Session.GetString("UseUserCompanyLayout") == "true";
    
    Layout = useUserCompanyLayout ? "_UserCompanyLayout" : "_Layout";
}
