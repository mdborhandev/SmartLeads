@model SmartLeads.Web.ViewComponents.NotificationBellViewModel

@* Notification Bell Component - Triggers Offcanvas Panel *@
<li class="nav-item">
    <a class="nav-link" href="javascript:void(0)" id="notificationBellBtn" aria-label="Notifications">
        <i class="icon-base bx bx-bell icon-md"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle notification-badge">@Model.UnreadCount</span>
        }
    </a>
</li>
