@model SmartLeads.Web.ViewComponents.NotificationBellViewModel

@* Notification Bell Component *@
<li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle hide-arrow" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <i class="icon-base bx bx-bell icon-md"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">@Model.UnreadCount</span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown">
        <div class="dropdown-header">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0">
                    <i class="icon-base bx bx-bell"></i> Notifications
                    @if (Model.UnreadCount > 0)
                    {
                        <span class="badge bg-primary">@Model.UnreadCount new</span>
                    }
                </h6>
                <a href="@Url.Action("Index", "Notifications")" class="btn btn-sm btn-link">
                    View All <i class="icon-base bx bx-right-arrow-alt"></i>
                </a>
            </div>
        </div>

        <div class="dropdown-divider"></div>

        <div class="notifications-list" style="max-height: 400px; overflow-y: auto;">
            @if (Model.RecentNotifications.Any())
            {
                @foreach (var notification in Model.RecentNotifications)
                {
                    <a href="@(!string.IsNullOrEmpty(notification.ActionUrl) ? notification.ActionUrl : Url.Action("Details", "Notifications", new { id = notification.Id }))"
                       class="dropdown-item notification-item @(notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread ? "unread" : "")">
                        <div class="notification-content">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="notification-title">
                                        @if (notification.Status == SmartLeads.Domain.Enums.NotificationStatus.Unread)
                                        {
                                            <span class="badge bg-primary badge-sm me-1">New</span>
                                        }
                                        <strong>@notification.Title</strong>
                                    </div>
                                    <p class="notification-message text-muted mb-1 small">
                                        @notification.Message.Substring(0, Math.Min(100, notification.Message.Length))@(notification.Message.Length > 100 ? "..." : "")
                                    </p>
                                    <div class="notification-meta">
                                        <span class="badge bg-info badge-sm">@notification.Type</span>
                                        <small class="text-muted ms-2">@notification.CreatedAt.ToString("MMM dd, HH:mm")</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="dropdown-divider m-0"></div>
                }
            }
            else
            {
                <div class="text-center py-4">
                    <i class="icon-base bx bx-bell-off fa-2x text-muted mb-2" style="font-size: 2rem;"></i>
                    <p class="text-muted mb-0">No notifications yet</p>
                </div>
            }
        </div>

        <div class="dropdown-divider"></div>

        <div class="dropdown-footer text-center">
            <a href="@Url.Action("Index", "Notifications")" class="btn btn-sm btn-primary">
                <i class="icon-base bx bx-bell"></i> View All Notifications
            </a>
            <a href="@Url.Action("Preferences", "Notifications")" class="btn btn-sm btn-link">
                <i class="icon-base bx bx-cog"></i> Settings
            </a>
        </div>
    </div>
</li>

<style>
    .notification-dropdown {
        width: 350px;
        padding: 0;
    }

    .notification-dropdown .dropdown-header {
        background-color: #f8f9fa;
        padding: 0.75rem 1rem;
    }

    .notification-item {
        padding: 0.75rem 1rem;
        white-space: normal;
    }

    .notification-item.unread {
        background-color: #f0f7ff;
        border-left: 3px solid #007bff;
    }

    .notification-item:hover {
        background-color: #f5f5f5;
    }

    .notification-title {
        margin-bottom: 0.25rem;
    }

    .notification-message {
        line-height: 1.4;
    }

    .notifications-list {
        min-height: 100px;
    }

    .dropdown-footer {
        padding: 0.75rem 1rem;
        background-color: #f8f9fa;
    }

    .badge-pill {
        border-radius: 10rem;
        padding: 0.25em 0.5em;
        font-size: 75%;
    }
</style>
