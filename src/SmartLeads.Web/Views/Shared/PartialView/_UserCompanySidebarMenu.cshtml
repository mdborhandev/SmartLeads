@using SmartLeads.Infrastructure.Services
@using SmartLeads.Infrastructure.Repositories.Interface
@inject ICompanyContext _companyContext
@inject IUnitOfWork _unitOfWork

@{
    var currentCompanyId = _companyContext.CurrentCompanyId;
    var currentCompany = currentCompanyId.HasValue 
        ? await _unitOfWork.systemDbContext.Companies.FindAsync(currentCompanyId.Value)
        : null;
    var userCompanies = await _companyContext.GetUserCompaniesAsync();
}

<ul class="menu-inner py-1">
    <!-- Dashboard -->
    <li class="menu-item">
        <a href="@Url.Action("NoCompany", "UserCompany")" class="menu-link">
            <i class="menu-icon icon-base bx bx-home-smile"></i>
            <div data-i18n="Dashboard">Dashboard</div>
        </a>
    </li>

    @if (userCompanies.Any())
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="My Companies">My Companies</span>
        </li>

        <!-- Show list of user's companies -->
        @foreach (var uc in userCompanies)
        {
            <li class="menu-item">
                <a href="javascript:void(0);" 
                   class="menu-link @(uc.CompanyId == currentCompanyId ? "active" : "")"
                   onclick="switchCompanySidebar('@uc.CompanyId', '@uc.Company.Name'); return false;">
                    <i class="menu-icon icon-base bx bx-@(uc.CompanyId == currentCompanyId ? "check-circle" : "circle")"></i>
                    <span class="text-truncate" style="max-width: 160px;">@uc.Company.Name</span>
                    @if (uc.IsDefault)
                    {
                        <span class="badge bg-label-primary ms-auto">Default</span>
                    }
                </a>
            </li>
        }
    }
    else
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="Get Started">Get Started</span>
        </li>
    }

    <li class="menu-header small">
        <span class="menu-header-text" data-i18n="Company Actions">Company Actions</span>
    </li>

    <li class="menu-item">
        <a href="javascript:void(0);" class="menu-link" data-bs-toggle="modal" data-bs-target="#joinCompanyModal">
            <i class="menu-icon icon-base bx bx-log-in-circle"></i>
            <div data-i18n="Join Company">Join Company</div>
        </a>
    </li>

    <li class="menu-item">
        <a href="@Url.Action("CreateCompany", "UserCompany")" class="menu-link">
            <i class="menu-icon icon-base bx bx-plus-circle"></i>
            <div data-i18n="Create Company">Create Company</div>
        </a>
    </li>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="Account">Account</span>
        </li>

        <li class="menu-item">
            <a href="@Url.Action("Profile", "Auth")" class="menu-link">
                <i class="menu-icon icon-base bx bx-user"></i>
                <div data-i18n="Profile">Profile</div>
            </a>
        </li>

        <li class="menu-item">
            <form asp-controller="Auth" asp-action="Logout" method="post" class="menu-link">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link menu-link p-0" style="width: 100%; text-align: left;">
                    <i class="menu-icon icon-base bx bx-power-off"></i>
                    <div data-i18n="Logout">Logout</div>
                </button>
            </form>
        </li>
    }
</ul>

<!-- Join Company Modal -->
<div class="modal fade" id="joinCompanyModal" tabindex="-1" aria-labelledby="joinCompanyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="joinCompanyModalLabel">
                    <i class="bx bx-log-in-circle me-2"></i>Join Company
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="JoinCompany" asp-controller="UserCompany" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="companyCode" class="form-label">Company Code</label>
                        <input type="text" class="form-control" id="companyCode" name="companyCode" placeholder="Enter company code" required />
                        <div class="form-text">Contact your administrator to get the company code.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bx bx-log-in me-1"></i> Join Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function switchCompanySidebar(companyId, companyName) {
        fetch('/UserCompany/SwitchCompany', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ companyId: companyId })
        })
        .then(response => {
            if (!response.ok) {
                return response.json().then(err => { throw err; });
            }
            return response.json();
        })
        .then(data => {
            if (data.success) {
                if (typeof toastr !== 'undefined') {
                    toastr.success(`Switched to ${companyName}`, 'Company Switched');
                }
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message || 'Failed to switch company', 'Error');
                }
            }
        })
        .catch(error => {
            console.error('Switch company failed:', error);
            if (typeof toastr !== 'undefined') {
                toastr.error(error.message || 'Failed to switch company', 'Error');
            }
        });
    }
</script>
