@using SmartLeads.Infrastructure.Services
@using SmartLeads.Infrastructure.Repositories.Interface
@inject ICompanyContext _companyContext
@inject IUnitOfWork _unitOfWork

@{
    var currentCompanyId = _companyContext.CurrentCompanyId;
    var currentCompany = currentCompanyId.HasValue 
        ? await _unitOfWork.systemDbContext.Companies.FindAsync(currentCompanyId.Value)
        : null;
    var userCompanies = await _companyContext.GetUserCompaniesAsync();
}

<ul class="menu-inner py-1">
    <!-- Dashboard -->
    <li class="menu-item">
        <a href="@Url.Action("NoCompany", "UserCompany")" class="menu-link">
            <i class="menu-icon icon-base bx bx-home-smile"></i>
            <div data-i18n="Dashboard">Dashboard</div>
        </a>
    </li>

    @if (userCompanies.Any())
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="My Companies">My Companies</span>
        </li>

        <!-- Show list of user's companies -->
        @foreach (var uc in userCompanies)
        {
            <li class="menu-item">
                <a href="javascript:void(0);" 
                   class="menu-link @(uc.CompanyId == currentCompanyId ? "active" : "")"
                   onclick="switchCompanySidebar('@uc.CompanyId', '@uc.Company.Name'); return false;">
                    <i class="menu-icon icon-base bx bx-@(uc.CompanyId == currentCompanyId ? "check-circle" : "circle")"></i>
                    <span class="text-truncate" style="max-width: 160px;">@uc.Company.Name</span>
                    @if (uc.IsDefault)
                    {
                        <span class="badge bg-label-primary ms-auto">Default</span>
                    }
                </a>
            </li>
        }
    }
    else
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="Get Started">Get Started</span>
        </li>
    }

    <li class="menu-item">
        <a href="@Url.Action("CreateCompany", "UserCompany")" class="menu-link">
            <i class="menu-icon icon-base bx bx-plus-circle"></i>
            <div data-i18n="Create Company">Create Company</div>
        </a>
    </li>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="menu-item" style="margin-top: auto; padding: 1rem;">
            <form asp-controller="Auth" asp-action="Logout" method="post" style="width: 100%;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger w-100" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    <i class="icon-base bx bx-power-off"></i>
                    <span data-i18n="Logout">Logout</span>
                </button>
            </form>
        </li>
    }
</ul>

<script>
    function switchCompanySidebar(companyId, companyName) {
        console.log('=== Company Switch Started ===');
        console.log('Company ID:', companyId);
        console.log('Company Name:', companyName);
        
        // Get token from meta tag or hidden input
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                    document.querySelector('meta[name="__RequestVerificationToken"]')?.content || '';
        console.log('CSRF Token found:', token ? 'Yes (' + token.substring(0, 20) + '...)' : 'No');

        fetch('/UserCompany/SwitchCompany', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ CompanyId: companyId })
        })
        .then(response => {
            console.log('Response status:', response.status);
            console.log('Response OK:', response.ok);
            if (!response.ok) {
                return response.json().then(err => {
                    console.error('=== Server Error ===');
                    console.error('Error details:', err);
                    throw err;
                });
            }
            return response.json();
        })
        .then(data => {
            console.log('=== Response Data ===');
            console.log('Success:', data.success);
            console.log('Message:', data.message);
            if (data.success) {
                if (typeof toastr !== 'undefined') {
                    toastr.success(`Switched to ${companyName}`, 'Company Switched');
                }
                setTimeout(() => {
                    console.log('Reloading page...');
                    window.location.reload();
                }, 1000);
            } else {
                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message || 'Failed to switch company', 'Error');
                }
            }
        })
        .catch(error => {
            console.error('=== Switch Company Failed ===');
            console.error('Error:', error);
            if (typeof toastr !== 'undefined') {
                toastr.error(error.message || 'Failed to switch company', 'Error');
            }
        });
    }
</script>
