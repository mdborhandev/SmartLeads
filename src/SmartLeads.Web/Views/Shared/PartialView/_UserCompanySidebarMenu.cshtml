@using SmartLeads.Infrastructure.Services
@using SmartLeads.Infrastructure.Repositories.Interface
@inject ICompanyContext _companyContext
@inject IUnitOfWork _unitOfWork

@{
    var currentCompanyId = _companyContext.CurrentCompanyId;
    var currentCompany = currentCompanyId.HasValue 
        ? await _unitOfWork.systemDbContext.Companies.FindAsync(currentCompanyId.Value)
        : null;
    var userCompanies = await _companyContext.GetUserCompaniesAsync();
    
    // Group companies by parent: parent companies first, then their children
    var parentCompanies = userCompanies.Where(uc => uc.Company.IsParent).ToList();
    var childCompanies = userCompanies.Where(uc => !uc.Company.IsParent && uc.Company.ParentCompanyId.HasValue).ToList();
    var standaloneCompanies = userCompanies.Where(uc => !uc.Company.IsParent && !uc.Company.ParentCompanyId.HasValue).ToList();
}

<ul class="menu-inner py-1">
    <!-- Dashboard -->
    <li class="menu-item">
        <a href="@Url.Action("NoCompany", "UserCompany")" class="menu-link">
            <i class="menu-icon icon-base bx bx-home-smile"></i>
            <div data-i18n="Dashboard">Dashboard</div>
        </a>
    </li>

    @if (userCompanies.Any())
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="My Companies">My Companies</span>
        </li>

        <!-- Show parent companies with their children -->
        @foreach (var parent in parentCompanies)
        {
            var children = childCompanies.Where(cc => cc.Company.ParentCompanyId == parent.CompanyId).ToList();
            <li class="menu-item @(children.Any() ? "menu-item-open" : "")">
                <a href="javascript:void(0);" 
                   class="menu-link @(parent.CompanyId == currentCompanyId ? "active" : "")"
                   onclick="switchCompanySidebar('@parent.CompanyId', '@parent.Company.Name'); return false;">
                    <i class="menu-icon icon-base bx bx-@(parent.CompanyId == currentCompanyId ? "check-circle" : "buildings")"></i>
                    <span class="text-truncate" style="max-width: 160px;">@parent.Company.Name</span>
                    @if (parent.IsDefault)
                    {
                        <span class="badge bg-label-primary ms-auto">Default</span>
                    }
                </a>
                @if (children.Any())
                {
                    <ul class="menu-sub">
                        @foreach (var child in children)
                        {
                            <li class="menu-item">
                                <a href="javascript:void(0);" 
                                   class="menu-link @(child.CompanyId == currentCompanyId ? "active" : "")"
                                   onclick="switchCompanySidebar('@child.CompanyId', '@child.Company.Name'); return false;">
                                    <i class="menu-icon icon-base bx bx-@(child.CompanyId == currentCompanyId ? "check-circle" : "circle")"></i>
                                    <span class="text-truncate" style="max-width: 140px;">@child.Company.Name</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </li>
        }

        <!-- Show standalone companies (no parent, not a parent) -->
        @foreach (var uc in standaloneCompanies)
        {
            <li class="menu-item">
                <a href="javascript:void(0);" 
                   class="menu-link @(uc.CompanyId == currentCompanyId ? "active" : "")"
                   onclick="switchCompanySidebar('@uc.CompanyId', '@uc.Company.Name'); return false;">
                    <i class="menu-icon icon-base bx bx-@(uc.CompanyId == currentCompanyId ? "check-circle" : "circle")"></i>
                    <span class="text-truncate" style="max-width: 160px;">@uc.Company.Name</span>
                    @if (uc.IsDefault)
                    {
                        <span class="badge bg-label-primary ms-auto">Default</span>
                    }
                </a>
            </li>
        }
    }
    else
    {
        <li class="menu-header small">
            <span class="menu-header-text" data-i18n="Get Started">Get Started</span>
        </li>
    }

    <li class="menu-item">
        <a href="@Url.Action("CreateCompany", "UserCompany")" class="menu-link">
            <i class="menu-icon icon-base bx bx-plus-circle"></i>
            <div data-i18n="Create Company">Create Company</div>
        </a>
    </li>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="menu-item mt-auto">
            <a href="javascript:void(0);" class="menu-link" onclick="document.getElementById('logoutForm').submit(); return false;">
                <i class="menu-icon icon-base bx bx-power-off"></i>
                <div data-i18n="Logout">Logout</div>
            </a>
            <form id="logoutForm" asp-controller="Auth" asp-action="Logout" method="post" style="display: none;">
                @Html.AntiForgeryToken()
            </form>
        </li>
    }
</ul>

<script>
    function switchCompanySidebar(companyId, companyName) {
        console.log('=== Company Switch Started ===');
        console.log('Company ID:', companyId);
        console.log('Company Name:', companyName);
        
        // Get token from meta tag or hidden input
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ||
                    document.querySelector('meta[name="__RequestVerificationToken"]')?.content || '';
        console.log('CSRF Token found:', token ? 'Yes (' + token.substring(0, 20) + '...)' : 'No');

        fetch('/UserCompany/SwitchCompany', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ CompanyId: companyId })
        })
        .then(response => {
            console.log('Response status:', response.status);
            console.log('Response OK:', response.ok);
            if (!response.ok) {
                return response.json().then(err => {
                    console.error('=== Server Error ===');
                    console.error('Error details:', err);
                    throw err;
                });
            }
            return response.json();
        })
        .then(data => {
            console.log('=== Response Data ===');
            console.log('Success:', data.success);
            console.log('Message:', data.message);
            if (data.success) {
                if (typeof toastr !== 'undefined') {
                    toastr.success(`Switched to ${companyName}`, 'Company Switched');
                }
                setTimeout(() => {
                    console.log('Redirecting to Company Info...');
                    window.location.href = '/UserCompany/CompanyInfo';
                }, 1000);
            } else {
                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message || 'Failed to switch company', 'Error');
                }
            }
        })
        .catch(error => {
            console.error('=== Switch Company Failed ===');
            console.error('Error:', error);
            if (typeof toastr !== 'undefined') {
                toastr.error(error.message || 'Failed to switch company', 'Error');
            }
        });
    }
</script>
