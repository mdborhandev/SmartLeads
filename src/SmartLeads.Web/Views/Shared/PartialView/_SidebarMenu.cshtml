<ul class="menu-inner py-1">
    <!-- Dashboard -->
    <li class="menu-item">
        <a href="@Url.Action("Index", "Home")" class="menu-link">
            <i class="menu-icon icon-base bx bx-home-smile"></i>
            <div data-i18n="Dashboard">Dashboard</div>
        </a>
    </li>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Employees -->
        <li class="menu-item">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-user"></i>
                <div data-i18n="Employees">Employees</div>
            </a>
            <ul class="menu-sub">
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Employees")" class="menu-link">
                        <div data-i18n="Employee List">Employee List</div>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Departments")" class="menu-link">
                        <div data-i18n="Departments">Departments</div>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Designations")" class="menu-link">
                        <div data-i18n="Designations">Designations</div>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Variables")" class="menu-link">
                        <div data-i18n="Variables">Variables</div>
                    </a>
                </li>
            </ul>
        </li>

        <li class="menu-item mt-auto">
            <a href="javascript:void(0);" class="menu-link" onclick="document.getElementById('logoutForm').submit(); return false;">
                <i class="menu-icon icon-base bx bx-power-off"></i>
                <div data-i18n="Logout">Logout</div>
            </a>
            <form id="logoutForm" asp-controller="Auth" asp-action="Logout" method="post" style="display: none;">
                @Html.AntiForgeryToken()
            </form>
        </li>
    }
</ul>
