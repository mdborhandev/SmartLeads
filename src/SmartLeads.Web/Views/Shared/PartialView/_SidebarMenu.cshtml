<ul class="menu-inner py-1">
    <!-- Dashboard -->
    <li class="menu-item">
        <a href="@Url.Action("Index", "Home")" class="menu-link">
            <i class="menu-icon icon-base bx bx-home-smile"></i>
            <div data-i18n="Dashboard">Dashboard</div>
        </a>
    </li>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Employees -->
        <li class="menu-item">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-user"></i>
                <div data-i18n="Employees">Employees</div>
            </a>
            <ul class="menu-sub">
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Employees")" class="menu-link">
                        <div data-i18n="Employee List">Employee List</div>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Departments")" class="menu-link">
                        <div data-i18n="Departments">Departments</div>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Designations")" class="menu-link">
                        <div data-i18n="Designations">Designations</div>
                    </a>
                </li>
            </ul>
        </li>

        <!-- Leads -->
        <li class="menu-item">
            <a href="javascript:void(0);" class="menu-link menu-toggle">
                <i class="menu-icon icon-base bx bx-network-chart"></i>
                <div data-i18n="Leads">Leads</div>
            </a>
            <ul class="menu-sub">
                <li class="menu-item">
                    <a href="@Url.Action("Index", "Contacts")" class="menu-link">
                        <div data-i18n="Contacts">Contacts</div>
                    </a>
                </li>
            </ul>
        </li>

        <li class="menu-item" style="margin-top: auto; padding: 1rem;">
            <form asp-controller="Auth" asp-action="Logout" method="post" style="width: 100%;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger w-100" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    <i class="icon-base bx bx-power-off"></i>
                    <span data-i18n="Logout">Logout</span>
                </button>
            </form>
        </li>
    }
</ul>
