@using SmartLeads.Domain.Enums
@using SmartLeads.Infrastructure.Repositories.Interface
@using SmartLeads.Infrastructure.Services
@inject IUnitOfWork _unitOfWork
@inject ICompanyContext _companyContext

@{
    string GetRoleDisplayName(UserRole role) => role switch
    {
        UserRole.SuperAdmin => "Super Admin",
        UserRole.Admin => "Admin",
        UserRole.Manager => "Manager",
        UserRole.User => "User",
        _ => "User"
    };

    string userDisplayName = User.Identity?.Name ?? "";
    string roleDisplay = "User";
    string firstName = "";
    string lastName = "";
    string fullName = "";
    string greeting = "Good day";

    // Get current company
    var currentCompanyId = _companyContext.CurrentCompanyId;
    var currentCompany = currentCompanyId.HasValue 
        ? await _unitOfWork.systemDbContext.Companies.FindAsync(currentCompanyId.Value)
        : null;

    // Get user's companies for the switcher
    var userCompanies = await _companyContext.GetUserCompaniesAsync();

    // Try to get role from claims if available
    var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role);
    if (roleClaim != null)
    {
        if (Enum.TryParse<UserRole>(roleClaim.Value, out var role))
        {
            roleDisplay = GetRoleDisplayName(role);
        }
    }

    // Get user details for first name and last name
    if (User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(userDisplayName))
    {
        var user = await _unitOfWork.userRepository.GetByUsernameOrEmailAsync(userDisplayName);
        if (user != null)
        {
            firstName = user.FirstName ?? "";
            lastName = user.LastName ?? "";
            fullName = string.IsNullOrWhiteSpace(firstName) && string.IsNullOrWhiteSpace(lastName)
                ? userDisplayName
                : $"{firstName} {lastName}".Trim();
        }
    }
}
<!DOCTYPE html>
<html lang="en"
      class="layout-navbar-fixed layout-menu-fixed layout-compact"
      dir="ltr"
      data-skin="default"
      data-bs-theme="light"
      data-assets-path="/gtlib/dependencylib/sneatlayout/assets/"
      data-template="vertical-menu-template">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@ViewData["Title"] - SmartLeads.Web</title>
    <meta name="description" content="" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="~/gtlib/v1.0.0/gtframework.bundle.css" />

    <!-- Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/gtlib/dependencylib/sneatlayout/assets/vendor/css/core.css" />

    <!-- Tabulator CSS -->
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/tabulator-tables@5.5.0/dist/css/tabulator_bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/tabulator.css" />

    <!-- Toastr CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/layout.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Helpers -->
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/js/helpers.js"></script>
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/js/template-customizer.js"></script>
    <script src="~/gtlib/dependencylib/sneatlayout/assets/js/config.js"></script>

    <script type="importmap"></script>
</head>
<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <aside id="layout-menu" class="layout-menu menu-vertical menu">
                <div class="app-brand demo">
                    <a href="@Url.Action("Index", "Home")" class="app-brand-link">
                        <span class="app-brand-logo demo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <line x1="19" y1="8" x2="19" y2="14"></line>
                                <line x1="22" y1="11" x2="16" y2="11"></line>
                            </svg>
                        </span>
                        <span class="app-brand-text demo menu-text fw-bold ms-2">Smart<span class="highlight">Leads</span></span>
                    </a>

                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="icon-base bx bx-chevron-left"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>

                @await Html.PartialAsync("~/Views/Shared/PartialView/_SidebarMenu.cshtml")
            </aside>

            <div class="menu-mobile-toggler d-xl-none rounded-1">
                <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large text-bg-secondary p-2 rounded-1">
                    <i class="icon-base bx bx-menu icon-md"></i>
                    <i class="icon-base bx bx-chevron-right icon-md"></i>
                </a>
            </div>
            <!-- / Menu -->
            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme"
                     id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0)">
                            <i class="icon-base bx bx-menu icon-md"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center justify-content-end" id="navbar-collapse">
                        <!-- Greeting -->
                        @if (User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(fullName))
                        {
                            <div class="navbar-nav align-items-center me-3">
                                <span class="nav-link">
                                    <i class="icon-base bx bx-sun me-1"></i>@greeting, <strong>@fullName</strong>
                                </span>
                            </div>
                        }

                        <ul class="navbar-nav flex-row align-items-center ms-md-auto">
                            <!-- Company Switcher -->
                            @if (User.Identity?.IsAuthenticated == true && userCompanies.Any())
                            {
                                <li class="nav-item dropdown me-2 me-xl-0">
                                    <a class="nav-link dropdown-toggle hide-arrow"
                                       id="companySwitcher"
                                       href="javascript:void(0);"
                                       data-bs-toggle="dropdown">
                                        <i class="icon-base bx bx-buildings icon-md"></i>
                                        <span class="d-none d-md-inline ms-2">@(currentCompany?.Name ?? "Select Company")</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="companySwitcher">
                                        @foreach (var uc in userCompanies)
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item @(uc.CompanyId == currentCompanyId ? "active" : "")"
                                                        onclick="switchCompany('@uc.CompanyId', '@uc.Company.Name')">
                                                    <i class="icon-base bx bx-@(uc.CompanyId == currentCompanyId ? "check-circle" : "circle") me-2"></i>
                                                    @uc.Company.Name
                                                    @if (uc.IsDefault)
                                                    {
                                                        <span class="badge bg-label-primary ms-2">Default</span>
                                                    }
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }

                            <!-- Layout Switcher -->
                            <li class="nav-item dropdown me-2 me-xl-0">
                                <a class="nav-link dropdown-toggle hide-arrow"
                                   id="layoutSwitcher"
                                   href="javascript:void(0);"
                                   data-bs-toggle="dropdown">
                                    <i class="icon-base bx bx-layout icon-md"></i>
                                    <span class="d-none ms-2">Layout</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="layoutSwitcher">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item"
                                                onclick="switchToUserCompanyLayout()">
                                            <i class="icon-base bx bx-briefcase me-2"></i>User Company Layout
                                        </button>
                                    </li>
                                </ul>
                            </li>

                            <!-- Style Switcher -->
                            <li class="nav-item dropdown me-2 me-xl-0">
                                <a class="nav-link dropdown-toggle hide-arrow"
                                   id="nav-theme"
                                   href="javascript:void(0);"
                                   data-bs-toggle="dropdown">
                                    <i class="icon-base bx bx-sun icon-md theme-icon-active"></i>
                                    <span class="d-none ms-2" id="nav-theme-text">Toggle theme</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nav-theme-text">
                                    <li>
                                        <button type="button"
                                                class="dropdown-item align-items-center active"
                                                data-bs-theme-value="light"
                                                aria-pressed="false">
                                            <span><i class="icon-base bx bx-sun icon-md me-3" data-icon="sun"></i>Light</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button"
                                                class="dropdown-item align-items-center"
                                                data-bs-theme-value="dark"
                                                aria-pressed="true">
                                            <span><i class="icon-base bx bx-moon icon-md me-3" data-icon="moon"></i>Dark</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button"
                                                class="dropdown-item align-items-center"
                                                data-bs-theme-value="system"
                                                aria-pressed="false">
                                            <span><i class="icon-base bx bx-desktop icon-md me-3" data-icon="desktop"></i>System</span>
                                        </button>
                                    </li>
                                </ul>
                            </li>
                            <!-- / Style Switcher-->

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- User -->
                                <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                    <a class="nav-link dropdown-toggle hide-arrow p-0"
                                       href="javascript:void(0);"
                                       data-bs-toggle="dropdown">
                                        <div class="avatar avatar-online">
                                            <img src="~/gtlib/dependencylib/sneatlayout/assets/img/avatars/1.png" alt class="rounded-circle" />
                                        </div>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                                <div class="d-flex">
                                                    <div class="flex-shrink-0 me-3">
                                                        <div class="avatar avatar-online">
                                                            <img src="~/gtlib/dependencylib/sneatlayout/assets/img/avatars/1.png" alt class="w-px-40 h-auto rounded-circle" />
                                                        </div>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="mb-0">@fullName</h6>
                                                        <small class="text-body-secondary">@@@userDisplayName - @roleDisplay</small>
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li>
                                            <div class="dropdown-divider my-1"></div>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                                <i class="icon-base bx bx-user icon-md me-3"></i>
                                                <span>Profile</span>
                                            </a>
                                        </li>
                                        <li>
                                            <div class="dropdown-divider my-1"></div>
                                        </li>
                                        <li>
                                            <form asp-controller="Auth" asp-action="Logout" method="post" class="dropdown-item">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-link dropdown-item p-0">
                                                    <i class="icon-base bx bx-power-off icon-md me-3"></i><span>Log Out</span>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                                <!--/ User -->
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a href="@Url.Action("Login", "Auth")" class="btn btn-sm btn-primary">Login</a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>

                <!-- / Navbar -->
                <!-- Content -->
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <main role="main">
                            @RenderBody()
                        </main>
                    </div>
                    <!-- / Content -->
                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl">
                            <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
                                <div class="mb-2 mb-md-0">
                                    &copy; 2026 - SmartLeads.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                                </div>
                            </div>
                        </div>
                    </footer>
                    <!-- / Footer -->
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>

    <!-- jQuery CDN -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    
    <!-- Antiforgery Token -->
    @Html.AntiForgeryToken()
    
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/js/bootstrap.js"></script>
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/libs/i18n/i18n.js"></script>
    <script src="~/gtlib/dependencylib/sneatlayout/assets/vendor/js/menu.js"></script>

    <!-- Main JS -->
    <script src="~/gtlib/dependencylib/sneatlayout/assets/js/main.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Tabulator JS -->
    <script src="https://unpkg.com/tabulator-tables@5.5.0/dist/js/tabulator.min.js"></script>
    <!-- SortableJS for drag-and-drop -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
    <!-- Export Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable/dist/jspdf.plugin.autotable.min.js"></script>

    <!-- Theme Switcher Script -->
    <script>
        (function() {
            const htmlElement = document.documentElement;
            const themeIconActive = document.querySelector('.theme-icon-active');
            
            // Get saved theme or default to 'light'
            const savedTheme = localStorage.getItem('theme') || 'light';
            setTheme(savedTheme);

            // Theme button click handlers
            document.querySelectorAll('[data-bs-theme-value]').forEach(button => {
                button.addEventListener('click', function() {
                    const themeValue = this.getAttribute('data-bs-theme-value');
                    setTheme(themeValue);
                    
                    // Update active state in dropdowns
                    document.querySelectorAll('[data-bs-theme-value]').forEach(btn => {
                        btn.classList.remove('active');
                        btn.closest('.dropdown-menu')?.querySelectorAll('.dropdown-item').forEach(item => {
                            item.setAttribute('aria-pressed', 'false');
                        });
                    });
                    this.classList.add('active');
                    this.closest('.dropdown-item')?.setAttribute('aria-pressed', 'true');
                });
            });

            function setTheme(theme) {
                localStorage.setItem('theme', theme);

                if (theme === 'system') {
                    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    htmlElement.setAttribute('data-bs-theme', systemTheme);
                    if (themeIconActive) {
                        updateIcon(systemTheme);
                    }
                } else {
                    htmlElement.setAttribute('data-bs-theme', theme);
                    if (themeIconActive) {
                        updateIcon(theme);
                    }
                }
            }

            function updateIcon(theme) {
                if (!themeIconActive) return;

                themeIconActive.classList.remove('bx-sun', 'bx-moon');
                if (theme === 'dark') {
                    themeIconActive.classList.add('bx-moon');
                } else {
                    themeIconActive.classList.add('bx-sun');
                }
            }

            // Listen for system theme changes
            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
                if (localStorage.getItem('theme') === 'system') {
                    setTheme('system');
                }
            });
        })();

        // Company Switcher Function
        function switchCompany(companyId, companyName) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/UserCompany/SwitchCompany', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ companyId: companyId })
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => { throw err; });
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    toastr.success(`Switched to ${companyName}`, 'Company Switched');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    toastr.error(data.message || 'Failed to switch company', 'Error');
                }
            })
            .catch(error => {
                console.error('Switch company failed:', error);
                toastr.error(error.message || 'Failed to switch company', 'Error');
            });
        }

        // Switch to User Company Layout
        function switchToUserCompanyLayout() {
            console.log('Switching to User Company Layout...');
            fetch('/UserCompany/SwitchLayout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ useUserCompanyLayout: true })
            })
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    return response.json().then(err => { throw err; });
                }
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    toastr.success('Switched to User Company Layout', 'Layout Changed');
                    setTimeout(() => {
                        // Redirect to UserCompany layout's default page
                        window.location.href = '/UserCompany/NoCompany';
                    }, 1000);
                } else {
                    toastr.error('Failed to switch layout', 'Error');
                }
            })
            .catch(error => {
                console.error('Switch layout failed:', error);
                toastr.error(error.message || 'Failed to switch layout', 'Error');
            });
        }
    </script>

    <!-- Services -->
    <script src="~/js/services/apiservice.js"></script>
    <script src="~/js/services/validation.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
